<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>DpiBypass.Core</AssemblyName>
    <RootNamespace>DpiBypass.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The engine is Windows-only by construction; the unit tests still run on
         any host because the parsers and planners never touch the OS. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the tests can pin implementation details that must not drift, such as the
         exact kernel filter the TTL fix installs. -->
    <InternalsVisibleTo Include="DpiBypass.Tests" />
  </ItemGroup>

</Project>

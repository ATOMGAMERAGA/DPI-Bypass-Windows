<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:DpiBypass.App.Infrastructure">

    <ResourceDictionary.MergedDictionaries>
        <!-- Tokens first: every style below reads its numbers from there with
             StaticResource, and a StaticResource can only see what was merged before
             it. Icons.xaml is generated from the official Fluent assets and is only
             ever read through FluentIcon. -->
        <ResourceDictionary Source="Tokens.xaml" />
        <ResourceDictionary Source="Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
      Design system for the main window. No style here writes a colour, a size, a
      radius or a duration of its own: colour comes from the palette (Light.xaml /
      Dark.xaml, swapped live by ThemeManager through DynamicResource) and every other
      number comes from Tokens.xaml. That is the whole rule, and it is what lets the
      window be re-spaced or re-timed without reading 1800 lines of markup.
    -->

    <!-- ======== Icons ========
         Microsoft Fluent System Icons, filled paths from the official assets rather
         than strokes drawn here by hand. FluentIcon resolves symbol + size to the
         right drawing; see Infrastructure/FluentIcon.cs and Theme/Icons.xaml. -->

    <Style TargetType="{x:Type infra:FluentIcon}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="Size" Value="{StaticResource IconSize.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type infra:FluentIcon}">
                    <!-- The box is the icon's design grid scaled to Size, so every glyph
                         occupies the same square whatever share of its grid it fills.
                         ClipToBounds keeps a glyph that overhangs its grid by a fraction
                         of a unit from nudging the layout around it. -->
                    <Grid Width="{TemplateBinding Size}"
                          Height="{TemplateBinding Size}"
                          Background="Transparent"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">
                        <Path Data="{TemplateBinding Data}"
                              Fill="{TemplateBinding Foreground}"
                              Stretch="None"
                              RenderTransform="{TemplateBinding GlyphScale}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Navigation rail icon: secondary while resting, accent and filled once its page
         is the one on screen - which is exactly the Regular/Filled pairing Fluent's
         family is drawn for. -->
    <Style x:Key="NavIconStyle" TargetType="{x:Type infra:FluentIcon}" BasedOn="{StaticResource {x:Type infra:FluentIcon}}">
        <Setter Property="Size" Value="{StaticResource IconSize.Body}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TabItem}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
                <Setter Property="Filled" Value="True" />
            </DataTrigger>
        </Style.Triggers>
    </Style>


    <!-- ======== Cards and panels ======== -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AppCardHoverBorderBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{DynamicResource AppHeroBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppHeroBorderBrush}" />
        <Setter Property="Padding" Value="20,18" />
    </Style>

    <!-- A quiet stat tile: one label and one value, used in rows of the status page. -->
    <Style x:Key="InfoTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Tile}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Monospace read-out panel for machine output (probe results, counters). -->
    <Style x:Key="MonoPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppCodeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
        <Setter Property="Padding" Value="14,11" />
    </Style>

    <!-- The compact top bar and the footer strip. Both stay transparent so Mica
         shows through; the surrounding hairline separates them from the body. -->
    <Style x:Key="ChromeBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Severity-reactive status pill for the top bar. Severity is "ok", "warn" or
         "off"; the shape and the colour both change so state is never colour-only. -->
    <Style x:Key="StatusPillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="{StaticResource Pad.Pill}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="ok">
                <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="warn">
                <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The pill's marker glyph: shield while off, a checked shield when ok, warning
         when warn. The glyph changes with the state as well as the colour, so the
         status is never carried by hue alone. -->
    <Style x:Key="StatusPillIconStyle" TargetType="{x:Type infra:FluentIcon}" BasedOn="{StaticResource {x:Type infra:FluentIcon}}">
        <Setter Property="Size" Value="{StaticResource IconSize.Small}" />
        <Setter Property="Symbol" Value="Shield" />
        <Setter Property="Foreground" Value="{DynamicResource AppNeutralBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="ok">
                <Setter Property="Symbol" Value="ShieldCheckmark" />
                <Setter Property="Filled" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="warn">
                <Setter Property="Symbol" Value="Warning" />
                <Setter Property="Filled" Value="True" />
                <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The hero status marker on the status page: a tinted disc plus glyph. -->
    <Style x:Key="StatusHeroDiscStyle" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="ok">
                <Setter Property="Background" Value="{DynamicResource AppSuccessSoftBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusSeverity}" Value="warn">
                <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StatusHeroIconStyle" TargetType="{x:Type infra:FluentIcon}" BasedOn="{StaticResource StatusPillIconStyle}">
        <Setter Property="Size" Value="{StaticResource IconSize.Large}" />
    </Style>

    <!-- ======== Typography ======== -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.BodyLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,{StaticResource Space.8}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>

    <Style x:Key="HintStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="FontSize" Value="{StaticResource Type.Hint}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextTertiaryBrush}" />
    </Style>

    <Style x:Key="MonospaceStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Type.FamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="InfoTileLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource HintStyle}">
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="InfoTileValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,3,0,0" />
    </Style>

    <!-- A card that reads as a caution rather than a plain panel: used for the
         settings that change how packets leave the machine system-wide. Keep the
         text style after CaptionStyle: StaticResource lookups in a resource
         dictionary cannot resolve a key declared later in the same dictionary. -->
    <Style x:Key="NoticeCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Background" Value="{DynamicResource AppWarningSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppWarningBrush}" />
        <Setter Property="Padding" Value="{StaticResource Pad.CardCompact}" />
    </Style>

    <Style x:Key="NoticeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
    </Style>

    <!-- A transient one-line result ("added", "removed"). Takes no space until it
         has something to say, so the layout does not jump around. The severity key
         on the view model ("ok" / "error" / "") picks the colour; the wording
         carries the meaning either way. -->
    <Style x:Key="StatusLineStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding DomainStatusSeverity}" Value="ok">
                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding DomainStatusSeverity}" Value="error">
                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The same "one transient line" idea, but taking its severity from its own Tag
         rather than from one named view-model property. A shared style that hard-codes
         a member name can only ever colour that one line correctly; anything else reusing
         it silently follows the wrong property. The wording still carries the meaning -
         the colour is a hint on top of it, never the only signal. -->
    <Style x:Key="SeverityStatusLineStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Tag" Value="ok">
                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="warn">
                <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="error">
                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======== Navigation rail ======== -->

    <!-- The latency headline carries the state, so it is coloured the same way the
         protection status line is: the wording is the meaning, the colour is a hint. -->
    <Style x:Key="LatencyHeadlineStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LatencyStatusSeverity}" Value="ok">
                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LatencyStatusSeverity}" Value="warn">
                <Setter Property="Foreground" Value="{DynamicResource AppWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LatencyStatusSeverity}" Value="info">
                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavTabControlStyle" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <!-- Padding becomes the content area's margin around the pages. -->
        <Setter Property="Padding" Value="{StaticResource Pad.Page}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="212"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <!--
                              The rail scrolls. Its items are a fixed list in a fixed
                              width column, so on a short window - or at a large text
                              scale - the last ones used to be clipped with no way to
                              reach them: the pages they lead to simply stopped
                              existing. The scrollbar only appears when it is needed.
                            -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                            <!--
                              StackPanel, not TabPanel. With TabStripPlacement=Left,
                              TabPanel arranges each item into DesiredSize *minus its
                              margin* and then advances by the same amount, while
                              FrameworkElement.ArrangeCore still subtracts that margin
                              from the slot. The item therefore renders taller than the
                              rect it was arranged into and WPF applies a layout clip -
                              which is what sliced the bottom edge and the lower rounded
                              corners off the selected item's blue chrome, by a differing
                              number of device pixels at every fractional DPI scale.
                              A StackPanel gives each item its full measured height, so
                              the gap between items is real layout space and nothing is
                              clipped. Nothing here needs TabPanel's multi-row wrapping,
                              which only ever applies to Top/Bottom placement anyway.
                            -->
                            <StackPanel IsItemsHost="True"
                                        Orientation="Vertical"
                                        Margin="12,6,10,12"
                                        UseLayoutRounding="True"
                                        SnapsToDevicePixels="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1"
                                Width="1"
                                Margin="0,10"
                                Background="{DynamicResource AppDividerBrush}" />
                        <ContentPresenter Grid.Column="2"
                                          ContentSource="SelectedContent"
                                          Margin="{TemplateBinding Padding}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NavTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
        <!--
          The 2px gap between rail items is deliberately NOT a margin on the TabItem.
          A margin here is layout the parent panel has to honour, and any panel that
          measures an item as "desired size minus margin" (WPF's own TabPanel does
          exactly that for Left/Right placement) arranges the item into a slot smaller
          than it measured, which WPF resolves with a layout clip across the bottom
          edge. The gap lives inside the template instead, where it is part of the
          item's own measured height and can never be dropped.
        -->
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!--
                      Spacer, not a negative margin or a transform: the gap below the
                      selected chrome is measured layout the item owns, so the blue
                      background always has its full 38px and its rounded corners
                      inside the arranged slot.
                    -->
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            MinHeight="38"
                            Margin="0,0,0,2"
                            Padding="10,8"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- Selection pill. It keeps its width when off so the
                                 labels of every item line up. -->
                            <Border x:Name="Pill"
                                    Grid.Column="0"
                                    Width="3"
                                    Height="16"
                                    Margin="0,0,11,0"
                                    CornerRadius="2"
                                    Background="Transparent"
                                    VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextBlock.FontSize="{StaticResource Type.Body}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppFocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== Buttons ======== -->

    <!-- One template keeps padding, icons, focus and disabled states consistent. -->
    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="{StaticResource Pad.Control}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource Radius.Tile}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <infra:FluentIcon x:Name="ActionIcon"
                                                  Size="{StaticResource IconSize.Small}"
                                                  Margin="{StaticResource Gap.InlineEnd}"
                                                  Symbol="{TemplateBinding infra:ActionButton.Symbol}"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Grid.Column="1" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="FocusRing" Margin="-3" CornerRadius="{StaticResource Radius.Tile}"
                                BorderThickness="2" IsHitTestVisible="False"
                                BorderBrush="{DynamicResource AppFocusStrokeBrush}"
                                Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="infra:ActionButton.Symbol" Value="{x:Null}">
                            <Setter TargetName="ActionIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AppCardHoverBorderBrush}" />
                <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="{StaticResource Pad.ControlPrimary}" />
        <Setter Property="MinHeight" Value="38" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource AppAccentPressedBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small square button for a single glyph. Its whole job is one icon, so the
         caller must set ToolTip and AutomationProperties.Name - there is no text
         to fall back on. -->
    <Style x:Key="GhostIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryActionButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ======== Lists ======== -->

    <Style x:Key="PlainListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />

        <!-- Every one of these lists sits inside a page that scrolls. See NestedScrolling. -->
        <Setter Property="infra:NestedScrolling.BubbleWheel" Value="True" />
    </Style>

    <Style x:Key="MonospaceListStyle" TargetType="ListBox" BasedOn="{StaticResource PlainListStyle}">
        <Setter Property="FontFamily" Value="{StaticResource Type.FamilyMono}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Caption}" />
    </Style>

    <!-- A list whose items are selectable cards, which is how Windows 11 settings
         presents a small set of mutually exclusive choices. -->
    <Style x:Key="ChoiceListStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Standard" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="infra:NestedScrolling.BubbleWheel" Value="True" />
    </Style>

    <Style x:Key="ChoiceCardStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,{StaticResource Space.8}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome"
                            Background="{DynamicResource AppCardBackgroundBrush}"
                            BorderBrush="{DynamicResource AppCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Tile}"
                            Padding="14,12"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,12,0">
                                <Ellipse x:Name="Ring"
                                         Stroke="{DynamicResource AppNeutralBrush}"
                                         StrokeThickness="1.5"
                                         Fill="Transparent" />
                                <Ellipse x:Name="Dot"
                                         Width="8"
                                         Height="8"
                                         Fill="{DynamicResource AppAccentBrush}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppFocusStrokeBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DomainRowStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppFocusStrokeBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TagStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Small}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="TagTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.Hint}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
    </Style>

    <!-- Recommended marker on a choice card. Calm by design: a hairline outline,
         accent text, and never larger than the title beside it. -->
    <Style x:Key="RecommendedTagBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="RecommendedTagTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.Hint}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
    </Style>

    <Style x:Key="BetaBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="BetaBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Hint}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="StatusPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AppCodeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource Border.Hairline}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}" />
        <Setter Property="Padding" Value="14,11" />
    </Style>

    <!-- ======== Switch ======== -->

    <!-- A Windows 11-style switch with a full clickable label and keyboard focus. -->
    <Style x:Key="SwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource Type.Body}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track"
                                Grid.Column="0"
                                Width="42"
                                Height="22"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AppToggleOffBrush}"
                                BorderBrush="{DynamicResource AppNeutralBrush}"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="2"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource AppToggleThumbBrush}" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Opacity" Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AppFocusStrokeBrush}" />
                            <Setter TargetName="Track" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== Expander for the advanced/risky settings group ======== -->

    <Style x:Key="AdvancedExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="ExpandDirection" Value="Down" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ToggleButton Grid.Row="0"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Content="{TemplateBinding Header}"
                                      HorizontalContentAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Cursor="Hand">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            Padding="2,4"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" ContentSource="Content" RecognizesAccessKey="True" />
                                            <infra:FluentIcon x:Name="Chevron"
                                                              Grid.Column="1"
                                                              Symbol="ChevronDown"
                                                              Size="{StaticResource IconSize.Small}"
                                                              Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                              Margin="10,0,2,0"
                                                              RenderTransformOrigin="0.5,0.5">
                                                <infra:FluentIcon.RenderTransform>
                                                    <!-- Its own instance, never a shared
                                                         resource: a Freezable in a style
                                                         setter is frozen and animating it
                                                         throws. -->
                                                    <RotateTransform Angle="0" />
                                                </infra:FluentIcon.RenderTransform>
                                            </infra:FluentIcon>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="Chevron"
                                                            Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                            To="180"
                                                            Duration="{StaticResource Motion.Fast}"
                                                            EasingFunction="{StaticResource Motion.EaseOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="Chevron"
                                                            Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                                            To="0"
                                                            Duration="{StaticResource Motion.Fast}"
                                                            EasingFunction="{StaticResource Motion.EaseOut}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AppSubtleBackgroundBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AppFocusStrokeBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          Grid.Row="1"
                                          ContentSource="Content"
                                          Visibility="Collapsed"
                                          Margin="0,14,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== The connection control ========
         The one thing the main screen is for. A ring around a round button: the ring
         carries the state, the button carries the action, and the label under them says
         in words what both of them are showing.

         Every animation here is opacity or a RenderTransform, which are the two things
         WPF composites without re-laying anything out. Nothing blurs, nothing resizes a
         layout slot, and nothing runs at all while the window is off screen - the whole
         control's motion is gated on MotionEnabled, which is Windows' own animation
         preference AND the app's own switch. -->

    <!-- The unlit ring. Always drawn, so the control has the same silhouette in every
         state and the lit arc has something to travel along. -->
    <Style x:Key="ConnectionRingTrackStyle" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{DynamicResource AppDividerBrush}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="Fill" Value="Transparent" />
    </Style>

    <!--
      The travelling arc.

      StrokeDashArray is in multiples of StrokeThickness, so at thickness 3 the ring's
      553 DIP circumference is 184 units: a 46/139 pattern draws one quarter of the
      circle and leaves the rest open. It turns by rotating the whole ellipse, which is
      a composited transform rather than a per-frame geometry rebuild.

      The RotateTransform itself is declared on the element in MainWindow.xaml, never
      here. A Freezable in a Style setter is frozen and shared by every element the
      style touches, and animating it throws "cannot animate on an immutable object
      instance" - which is how this window once shipped a page transition that never
      ran for the life of the process.
    -->
    <Style x:Key="ConnectionRingArcStyle" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="StrokeDashArray" Value="46 139" />
        <Setter Property="StrokeDashCap" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <!-- Turning: something is actually happening and motion is allowed. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsConnectionWorking}" Value="True" />
                    <Condition Binding="{Binding MotionEnabled}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                    <BeginStoryboard x:Name="SpinStoryboard">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource Motion.Fast}" />
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                             From="0" To="360"
                                             Duration="{StaticResource Motion.RingSpin}"
                                             RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource Motion.Fast}" />
                        </Storyboard>
                    </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
            </MultiDataTrigger>

            <!-- Working with motion switched off: the arc is shown standing still, so the
                 state is still visible without anything moving. -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsConnectionWorking}" Value="True" />
                    <Condition Binding="{Binding MotionEnabled}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Opacity" Value="1" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The finished ring: a complete circle that arrives once, on success. -->
    <Style x:Key="ConnectionRingCompleteStyle" TargetType="Ellipse">
        <Setter Property="Stroke" Value="{DynamicResource AppSuccessBrush}" />
        <Setter Property="StrokeThickness" Value="3" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConnectionPhase}" Value="Connected">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1"
                                             Duration="{StaticResource Motion.State}"
                                             EasingFunction="{StaticResource Motion.EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="{StaticResource Motion.Content}" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.ExitActions>
            </DataTrigger>
            <DataTrigger Binding="{Binding ConnectionPhase}" Value="Failed">
                <Setter Property="Stroke" Value="{DynamicResource AppDangerBrush}" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
      The button in the middle. Its template is the only place the disc, the glyph and
      the press response are described, so every state of the control is one file.
    -->
    <Style x:Key="ConnectButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppOnAccentTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="132" />
        <Setter Property="Height" Value="132" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <Ellipse x:Name="FocusRing"
                                 Stroke="{DynamicResource AppFocusStrokeBrush}"
                                 StrokeThickness="{StaticResource Stroke.Focus}"
                                 Margin="-6"
                                 Opacity="0"
                                 IsHitTestVisible="False" />

                        <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" />

                        <infra:FluentIcon x:Name="Glyph"
                                          Symbol="{Binding ConnectionSymbol}"
                                          Size="{StaticResource IconSize.Hero}"
                                          Foreground="{TemplateBinding Foreground}"
                                          RenderTransformOrigin="0.5,0.5">
                            <infra:FluentIcon.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </infra:FluentIcon.RenderTransform>
                        </infra:FluentIcon>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource AppAccentHoverBrush}" />
                        </Trigger>

                        <!-- The press response: a small, quick squeeze. Scale rather than
                             a colour change, because the disc already changes colour with
                             the connection state and two meanings on one channel is how a
                             control stops reading. -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource AppAccentPressedBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="0.96" Duration="{StaticResource Motion.Instant}" />
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="0.96" Duration="{StaticResource Motion.Instant}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         To="1" Duration="{StaticResource Motion.Fast}"
                                                         EasingFunction="{StaticResource Motion.EaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         To="1" Duration="{StaticResource Motion.Fast}"
                                                         EasingFunction="{StaticResource Motion.EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                        </Trigger>

                        <!-- Connected: the disc goes green and the tick arrives with a
                             single settling step rather than appearing. -->
                        <DataTrigger Binding="{Binding ConnectionPhase}" Value="Connected">
                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource AppSuccessBrush}" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glyph"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                         From="0.6" To="1"
                                                         Duration="{StaticResource Motion.State}"
                                                         EasingFunction="{StaticResource Motion.Overshoot}" />
                                        <DoubleAnimation Storyboard.TargetName="Glyph"
                                                         Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                         From="0.6" To="1"
                                                         Duration="{StaticResource Motion.State}"
                                                         EasingFunction="{StaticResource Motion.Overshoot}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ConnectionPhase}" Value="Failed">
                            <Setter TargetName="Disc" Property="Fill" Value="{DynamicResource AppDangerBrush}" />
                        </DataTrigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The headline under the ring. It changes often, so it changes with a short
         cross-fade rather than snapping - which at this size reads as a jump. -->
    <Style x:Key="ConnectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Type.Subtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ConnectionPhase}" Value="Connected">
                <Setter Property="Foreground" Value="{DynamicResource AppSuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ConnectionPhase}" Value="Failed">
                <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConnectionDetailStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======== Page transitions ======== -->

    <!-- Everything a page surface is, minus the entrance. App.ApplyMotionPreference
         swaps this in wholesale when Windows reports that client area animation is
         switched off, which is why it exists as its own style rather than as a
         trigger somebody edits at runtime: a Style is sealed the moment it is first
         applied, so the collection cannot be changed afterwards. -->
    <Style x:Key="PageSurfaceStaticStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="0,0,6,0" />
        <Setter Property="Opacity" Value="1" />

        <!-- Physical scrolling. Item-based scrolling moves a page surface one whole
             card per wheel notch, which reads as the page jumping rather than
             scrolling, and leaves the last card unreachable when it is taller than
             the viewport. -->
        <Setter Property="CanContentScroll" Value="False" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>

    <!--
      Page entrance: a short fade. Deliberately only the opacity, which is a property
      of the element itself. The rise this used to have animated a TranslateTransform
      declared in this setter block, and a Freezable in a Style setter is frozen and
      shared by every element the style touches - so the animation threw "cannot
      animate on an immutable object instance" on every page load, was swallowed by
      the dispatcher's handler, and left an error in the log for a 180ms flourish that
      never once ran.
    -->
    <Style x:Key="PageSurfaceAnimatedStyle" TargetType="ScrollViewer" BasedOn="{StaticResource PageSurfaceStaticStyle}">
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0.82" To="1" Duration="0:0:0.18">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut" />
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- What the pages actually use. App.ApplyMotionPreference points this key at one of
         the two above, before the window is built and again when the preference changes:
         a Style is sealed the first time it is applied, so the choice has to be made by
         swapping the resource rather than by editing a trigger collection at runtime. -->
    <Style x:Key="PageSurfaceStyle" TargetType="ScrollViewer" BasedOn="{StaticResource PageSurfaceAnimatedStyle}" />

</ResourceDictionary>

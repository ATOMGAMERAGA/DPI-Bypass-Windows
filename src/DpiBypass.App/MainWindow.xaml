<Window x:Class="DpiBypass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:DpiBypass.App.Infrastructure"
        Title="DPI Bypass"
        Width="1080"
        Height="780"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Assets/dpibypass.ico"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <infra:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsedConverter" />
        <infra:SeverityToBrushConverter x:Key="SeverityBrushConverter" />
        <infra:HotspotCheckStateToBrushConverter x:Key="CheckStateBrushConverter" />
        <infra:MeasuredToOpacityConverter x:Key="MeasuredOpacityConverter" />
    </Window.Resources>

    <!-- Shell: a compact top bar (brand, live protection status, primary action),
         a navigation rail on the left and a footer with version and exit. The bar,
         the rail and the footer stay transparent so Mica shows through; hairlines
         separate them from the page content. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= Top bar ======================= -->
        <Border Grid.Row="0"
                Style="{StaticResource ChromeBorderStyle}"
                BorderThickness="0,0,0,1"
                Padding="20,12,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- A 256px source for a 34px slot stays sharp well past 350%
                         scaling without decoding a megapixel bitmap. -->
                    <Border Width="34"
                            Height="34"
                            Background="{DynamicResource AppAccentSoftBrush}"
                            CornerRadius="8">
                        <Image Width="26"
                               Height="26"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="Assets/dpibypass-256.png" />
                    </Border>
                    <TextBlock Text="{Binding ProductTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>

                <!-- Live protection status. Shape and colour both react to the
                     severity; the detail rides on the tooltip. -->
                <Border Grid.Column="2"
                        Style="{StaticResource StatusPillBorderStyle}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip="{Binding StatusDetail}"
                        AutomationProperties.Name="Koruma durumu">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource StatusPillIconStyle}" />
                        <TextBlock Text="{Binding StatusHeadline}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- The primary action is reachable from every page. -->
                <Button Grid.Column="3"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        MinWidth="170"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleCommand}"
                        Content="{Binding ToggleCaption}" />
            </Grid>
        </Border>

        <!-- ======================= Body ======================= -->
        <TabControl Grid.Row="1"
                    x:Name="NavigationTabs"
                    Style="{StaticResource NavTabControlStyle}"
                    SelectionChanged="OnNavigationSelectionChanged">

            <!-- ============ Durum ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Durum">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconShieldGeometry}" />
                        <AccessText Text="_Durum" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel>

                        <!-- Hero: answers "is protection on, what is it doing,
                             and is there anything for me to do" at a glance. -->
                        <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Style="{StaticResource StatusHeroDiscStyle}"
                                        Margin="0,0,16,0"
                                        VerticalAlignment="Top">
                                    <Path Style="{StaticResource StatusHeroIconStyle}" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding StatusHeadline}"
                                               FontSize="19"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                    <TextBlock Text="{Binding StatusDetail}"
                                               Style="{StaticResource CaptionStyle}"
                                               Margin="0,3,0,0" />
                                    <TextBlock Style="{StaticResource CaptionStyle}" Margin="0,10,0,0">
                                        <Run Text="Kapsam:" />
                                        <Run Text="{Binding SelectedScope.Title, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Style="{StaticResource PrimaryActionButtonStyle}"
                                            MinWidth="190"
                                            MinHeight="40"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding ToggleCommand}"
                                            Content="{Binding ToggleCaption}" />
                                    <!-- Real busy state: visible only while the
                                         engine is actually starting or stopping. -->
                                    <ProgressBar Height="3"
                                                 Margin="0,10,0,0"
                                                 IsIndeterminate="{Binding IsBusy}"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Background="{DynamicResource AppSubtleBackgroundBrush}"
                                                 Foreground="{DynamicResource AppAccentBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Applied, but not written down. The setting is doing what the
                             user asked for this session; the file on disk is not, and the
                             app used to say nothing at all about the difference. The icon
                             carries the meaning as well as the colour. -->
                        <Border Style="{StaticResource NoticeCardStyle}"
                                Margin="0,0,0,12"
                                AutomationProperties.Name="Ayar kaydetme uyarısı"
                                Visibility="{Binding SettingsSaveFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0"
                                      Data="{StaticResource IconWarningGeometry}"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      Fill="{DynamicResource AppWarningBrush}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource NoticeTextStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="{Binding SettingsSaveWarning, Mode=OneWay}" />
                                <Button Grid.Column="2"
                                        Content="Yeniden kaydet"
                                        MinWidth="130"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding RetrySaveCommand}" />
                            </Grid>
                        </Border>

                        <!-- What the engine is working with. Equal columns use the
                             whole card width instead of leaving a dead strip on the
                             right at the window's normal size. -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="Ağ" Style="{StaticResource InfoTileLabelStyle}" />
                                    <TextBlock Text="{Binding NetworkName}" Style="{StaticResource InfoTileValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="Operatör" Style="{StaticResource InfoTileLabelStyle}" />
                                    <TextBlock Text="{Binding IspSummary}" Style="{StaticResource InfoTileValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="Yöntem" Style="{StaticResource InfoTileLabelStyle}" />
                                    <TextBlock Text="{Binding StrategySummary}" Style="{StaticResource InfoTileValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="Kapsam" Style="{StaticResource InfoTileLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedScope.Title}" Style="{StaticResource InfoTileValueStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,12">
                            <StackPanel>
                                <TextBlock Text="Bağlantı testi" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="Gerçek bir TLS el sıkışması yapılır ve sertifika doğrulanır. Yalnızca bağlantı kurulması değil, araya girilmediği de kontrol edilir." />

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                                    <Button Content="discord.com testi"
                                            MinWidth="150"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding TestCommand}" />
                                    <Button Content="Tüm Discord adresleri"
                                            MinWidth="180"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding TestAllCommand}" />
                                </StackPanel>

                                <Border Style="{StaticResource MonoPanelStyle}">
                                    <TextBlock Text="{Binding ProbeSummary}" Style="{StaticResource MonospaceStyle}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Motor sayaçları" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding EngineCounters}" Style="{StaticResource MonospaceStyle}" />
                                <TextBlock Text="{Binding DnsSummary}" Style="{StaticResource MonospaceStyle}" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,12,0,0"
                                           Text="Yalnızca bağlantının ilk veri paketi işlenir. Ping, ses trafiği ve indirme hızı çekirdek süzgecine hiç girmediği için etkilenmez." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Kapsam ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Kapsam">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconLayersGeometry}" />
                        <AccessText Text="_Kapsam" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="Ne korunsun?" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Margin="0,0,0,14"
                                   Text="Kapsam ne kadar dar olursa sisteme etkisi de o kadar az olur. Discord uygulaması, çalışan süreç adına göre tanınır." />

                        <ListBox Style="{StaticResource ChoiceListStyle}"
                                 ItemContainerStyle="{StaticResource ChoiceCardStyle}"
                                 ItemsSource="{Binding ScopeOptions}"
                                 SelectedItem="{Binding SelectedScope, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <Border Style="{StaticResource RecommendedTagBorderStyle}"
                                                    Margin="9,0,0,0"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Önerilen" Style="{StaticResource RecommendedTagTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,12">
                            <StackPanel>
                                <TextBlock Text="Bu bilgisayarda bulunanlar" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Discord" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding DiscordSummary}" Style="{StaticResource BodyStyle}" Margin="0,0,0,12" />
                                <TextBlock Text="Tarayıcılar" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding BrowserSummary}" Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="QUIC el sıkışmalarını engelle" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="QUIC, alan adını şifreli taşıdığı için burada uygulanan yöntemler ona ulaşamaz. Yeni QUIC el sıkışmaları reddedilirse tarayıcı saniyeler içinde TCP'ye döner ve koruma devreye girer. Yalnızca korunan programlar etkilenir." />
                                <CheckBox Content="Korunan programlar için QUIC'i engelle (önerilen)"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding BlockQuic, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Siteler ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Siteler">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconGlobeGeometry}" />
                        <AccessText Text="_Siteler" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Korunan siteler" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Bu listedeki alan adlarına giden bağlantılarda atlatma uygulanır. Alt alan adları kendiliğinden kapsanır." />
                        <TextBlock Text="{Binding DomainSummary}" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Text="Alan adı ekle" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         MinHeight="34"
                                         VerticalContentAlignment="Center"
                                         Padding="10,7"
                                         AutomationProperties.Name="Eklenecek alan adı"
                                         Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="Ekle"
                                        MinWidth="100"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding AddDomainCommand}" />
                                <Button Grid.Column="2"
                                        Content="Seçileni çıkar"
                                        MinWidth="140"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding RemoveDomainCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding DomainStatus}"
                                       Style="{StaticResource StatusLineStyle}"
                                       Margin="0,8,0,0" />

                            <CheckBox Content="Yeni engelli siteleri kendiliğinden bul (önerilen)"
                                      Margin="0,14,0,0"
                                      Style="{StaticResource SwitchStyle}"
                                      IsChecked="{Binding AutoDiscover, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Margin="26,4,0,0"
                                       Text="Açtığınız yeni bir alan adı atlatmasız açılmayıp atlatmayla açılıyorsa sessizce sınanır ve kalıcı olarak listeye eklenir." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="4,4,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             Padding="30,6,8,6"
                                             AutomationProperties.Name="Alan adı ara"
                                             Text="{Binding DomainFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    <Path Data="{StaticResource IconSearchGeometry}"
                                          Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          HorizontalAlignment="Left"
                                          Margin="10,0,0,0"
                                          IsHitTestVisible="False"
                                          Stroke="{DynamicResource AppTextSecondaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Grid>
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostIconButtonStyle}"
                                        Margin="6,0,0,0"
                                        Command="{Binding ClearDomainFilterCommand}"
                                        ToolTip="Aramayı temizle"
                                        AutomationProperties.Name="Aramayı temizle">
                                    <Path Data="{StaticResource IconCloseGeometry}"
                                          Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AppTextSecondaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Button>
                            </Grid>

                            <!-- The empty state sits over the list and only shows
                                 when the (possibly filtered) view has no rows. -->
                            <Grid Grid.Row="1">
                                <ListBox Style="{StaticResource PlainListStyle}"
                                         ItemContainerStyle="{StaticResource DomainRowStyle}"
                                         ItemsSource="{Binding FilteredDomains}"
                                         SelectedItem="{Binding SelectedDomain, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Domain}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                <Border Grid.Column="1" Style="{StaticResource TagStyle}">
                                                    <TextBlock Text="{Binding OriginLabel}" Style="{StaticResource TagTextStyle}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border IsHitTestVisible="False"
                                        Padding="12,18"
                                        Visibility="{Binding DomainsViewEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Gösterilecek alan adı yok."
                                                   Style="{StaticResource BodyStyle}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Aramayı temizleyin ya da yukarıdaki alandan yeni bir alan adı ekleyin."
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ Ağ ve yöntem ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Ağ ve yöntem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSignalGeometry}" />
                        <AccessText Text="Ağ ve _yöntem" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bulunduğunuz ağ" Style="{StaticResource SectionTitleStyle}" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource InfoTileStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Ağ adı" Style="{StaticResource InfoTileLabelStyle}" />
                                            <TextBlock Text="{Binding NetworkName}" Style="{StaticResource InfoTileValueStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource InfoTileStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Algılanan operatör" Style="{StaticResource InfoTileLabelStyle}" />
                                            <TextBlock Text="{Binding IspSummary}" Style="{StaticResource InfoTileValueStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="Ağ değiştiğinde (örneğin başka bir Wi-Fi adına geçtiğinizde) yeni ağ için yöntem arka planda yeniden bulunur. Daha önce çalışan yöntem hatırlanır ve önce o denenir." />

                                <CheckBox Content="Ağ değişince yöntemi kendiliğinden yeniden ara"
                                          Margin="0,10,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding AutoTuneOnNetworkChange, Mode=TwoWay}" />

                                <TextBlock Text="Operatör" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4" />
                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding IspOptions}"
                                          SelectedItem="{Binding SelectedIsp, Mode=TwoWay}"
                                          MinWidth="320"
                                          MinHeight="34"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Aşma yöntemi" Style="{StaticResource SectionTitleStyle}" />

                                <TextBlock Text="Etkin yöntem" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding StrategySummary}"
                                           Style="{StaticResource InfoTileValueStyle}"
                                           Margin="0,0,0,12" />

                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding StrategyOptions}"
                                          SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                                          MinWidth="380"
                                          MinHeight="34"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Text="{Binding SelectedStrategyDescription}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,8,0,0" />

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Yeniden tara"
                                            MinWidth="150"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding RetuneCommand}" />
                                    <!-- Real tuning progress: only while the sweep runs. -->
                                    <ProgressBar Width="90"
                                                 Height="3"
                                                 Margin="12,0,0,0"
                                                 VerticalAlignment="Center"
                                                 IsIndeterminate="{Binding IsTuning}"
                                                 Visibility="{Binding IsTuning, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Background="{DynamicResource AppSubtleBackgroundBrush}"
                                                 Foreground="{DynamicResource AppAccentBrush}" />
                                    <TextBlock Text="{Binding TuningStatus}"
                                               Style="{StaticResource CaptionStyle}"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Son korunan adresler" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Style="{StaticResource MonospaceListStyle}"
                                         ItemContainerStyle="{StaticResource DomainRowStyle}"
                                         ItemsSource="{Binding ProtectedHosts}"
                                         MaxHeight="200" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ DNS ve ayarlar ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="DNS ve ayarlar">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconSlidersGeometry}" />
                        <AccessText Text="DNS ve _ayarlar" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Alan adı çözümleme" Style="{StaticResource SectionTitleStyle}" />
                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding DnsOptions}"
                                          SelectedItem="{Binding SelectedDns, Mode=TwoWay}"
                                          MinWidth="380"
                                          MinHeight="34"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Text="{Binding SelectedDnsDescription}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,8,0,12" />
                                <Border Style="{StaticResource MonoPanelStyle}">
                                    <TextBlock Text="{Binding DnsSummary}" Style="{StaticResource MonospaceStyle}" />
                                </Border>
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,12,0,0"
                                           Text="Çözümleyicilere IP adresiyle bağlanılır; böylece TLS içinde alan adı hiç gönderilmez ve DNS trafiği alan adına göre süzülemez. Koruma kapatıldığında özgün DNS ayarlarınız geri yüklenir." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Başlangıç ve pencere" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Content="Windows açılışında başlat"
                                          Margin="0,0,0,4"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="26,0,0,10"
                                           Text="Windows Başlangıç Uygulamaları listesine eklenir; yükseltilmiş görev sayesinde her açılışta yönetici onayı sorulmaz." />
                                <CheckBox Content="Açılışta pencereyi göstermeden tepside başla"
                                          Margin="0,0,0,4"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding StartMinimised, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="26,0,0,10"
                                           Text="Tepsideyken simgeye çift tıklayarak ya da kısayolu yeniden çalıştırarak pencereyi geri getirebilirsiniz." />
                                <CheckBox Content="Uygulama açılırken korumayı da başlat"
                                          Margin="0,0,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding StartEngineOnLaunch, Mode=TwoWay}" />
                                <CheckBox Content="Pencere kapatıldığında tepsiye küçült"
                                          Margin="0,10,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding MinimiseToTrayOnClose, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Düzenli denetim" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,0,0,10"
                                           Text="Seçili yöntem belirli aralıklarla yeniden sınanır. Operatör kural değiştirdiğinde yeni bir yöntem kendiliğinden aranır." />
                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding RecheckOptions}"
                                          SelectedItem="{Binding SelectedRecheck, Mode=TwoWay}"
                                          MinWidth="260"
                                          MinHeight="34"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- ===== Ping düşürme =====
                             Ordered as a person works: what it is, what to measure, one
                             button, the numbers, one sentence about them, and only then
                             the technical surface. Everything a developer needs and a
                             user does not lives under "Ölçüm ayrıntıları". -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>

                                <!-- 1. Title, and the two states that are not the same
                                     thing: the switch the user set, and whether a
                                     verified setting is in place right now. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="Ping düşürme"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,0,10,0"
                                                   VerticalAlignment="Center" />
                                        <Border Style="{StaticResource BetaBadgeStyle}" VerticalAlignment="Center">
                                            <TextBlock Text="BETA" Style="{StaticResource BetaBadgeTextStyle}" />
                                        </Border>
                                    </StackPanel>

                                    <CheckBox Grid.Column="1"
                                              Content="Etkin"
                                              Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Ping düşürmeyi etkinleştir"
                                              IsChecked="{Binding LowLatencyMode, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="{Binding LatencyHeadline}"
                                           Style="{StaticResource LatencyHeadlineStyle}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding LatencyStatusSeverity, Converter={StaticResource SeverityBrushConverter}}" />

                                <!-- 2. Target. Only the inputs the choice actually needs
                                     are shown, and the error sits under the field it is
                                     about rather than at the bottom of the card. -->
                                <TextBlock Text="Ne ölçülsün?"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,16,0,4" />
                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding LatencyTargetOptions}"
                                          SelectedItem="{Binding SelectedLatencyTarget, Mode=TwoWay}"
                                          MinWidth="260"
                                          MinHeight="34"
                                          MaxWidth="420"
                                          HorizontalAlignment="Left"
                                          AutomationProperties.Name="Ölçüm hedefi"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Text="{Binding SelectedLatencyTarget.Description}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap" />

                                <StackPanel Margin="0,10,0,0"
                                            Visibility="{Binding IsCustomLatencyTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBox MinHeight="34"
                                             MaxWidth="420"
                                             HorizontalAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             AutomationProperties.Name="Sunucu adresi"
                                             Text="{Binding LatencyCustomTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Örnek: sunucu.com · sunucu.com:25565 · udp://1.2.3.4:7777"
                                               Style="{StaticResource HintStyle}"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Margin="0,10,0,0"
                                      Visibility="{Binding IsApplicationLatencyTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" MaxWidth="420" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                              Grid.Column="0"
                                              MinHeight="34"
                                              VerticalContentAlignment="Center"
                                              AutomationProperties.Name="Ölçülecek uygulama"
                                              ItemsSource="{Binding LatencyProcesses}"
                                              SelectedItem="{Binding SelectedLatencyProcess, Mode=TwoWay}" />
                                    <Button Grid.Column="1"
                                            Content="Yenile"
                                            MinWidth="90"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding RefreshLatencyProcessesCommand}" />
                                </Grid>

                                <!-- The error belongs to the field above it, and the
                                     buttons below are disabled while it is showing. -->
                                <TextBlock Text="{Binding LatencyTargetError}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Assertive"
                                           Visibility="{Binding LatencyTargetError, Converter={StaticResource EmptyToCollapsedConverter}}"
                                           Foreground="{DynamicResource AppDangerBrush}" />

                                <!-- 3. One button. Its label is the next step the engine
                                     itself worked out, so there is never a row of five
                                     equally weighted actions to choose between. -->
                                <Button Content="{Binding LatencyPrimaryAction}"
                                        MinWidth="220"
                                        MinHeight="38"
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        IsDefault="True"
                                        Command="{Binding LatencyPrimaryCommand}" />

                                <!-- 4. The numbers. A card with nothing behind it says so
                                     and dims; it never prints a zero nobody measured. -->
                                <ItemsControl ItemsSource="{Binding LatencyCards}" Margin="0,16,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InfoTileStyle}"
                                                    MinWidth="150"
                                                    Margin="0,0,8,8"
                                                    Opacity="{Binding Measured, Converter={StaticResource MeasuredOpacityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource InfoTileLabelStyle}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Value}"
                                                               Style="{StaticResource InfoTileValueStyle}" />
                                                    <TextBlock Text="{Binding Note}"
                                                               Style="{StaticResource HintStyle}"
                                                               Margin="0,2,0,0"
                                                               MaxWidth="260"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap">
                                    <Run Text="{Binding LatencyTargetSummary, Mode=OneWay}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding LatencyMeasuredAt, Mode=OneWay}" />
                                </TextBlock>

                                <!-- 5. One sentence about what happened, one about what
                                     to do next. Nothing else competes with them. -->
                                <TextBlock Text="{Binding LatencySuggestion}"
                                           Style="{StaticResource BodyStyle}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           Visibility="{Binding LatencySuggestion, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                <!-- 6. Progress, for every run and not only the deep test,
                                     with a stop button that is live throughout. -->
                                <Border Style="{StaticResource StatusPanelStyle}"
                                        Margin="0,14,0,0"
                                        Visibility="{Binding IsLatencyProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding LatencyProgressTitle}"
                                                       Style="{StaticResource LatencyHeadlineStyle}"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="İptal et"
                                                    MinWidth="110"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyCancelCommand}" />
                                        </Grid>

                                        <!-- Indeterminate on purpose: the run has no
                                             predictable total, and a percentage with no
                                             data behind it is a made-up number. -->
                                        <ProgressBar Height="3"
                                                     Margin="0,10,0,0"
                                                     IsIndeterminate="True"
                                                     Background="{DynamicResource AppSubtleBackgroundBrush}"
                                                     Foreground="{DynamicResource AppAccentBrush}" />

                                        <TextBlock Text="{Binding LatencyStageInstruction}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding LatencyStageInstruction, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                        <TextBlock Text="{Binding LatencyStageRate}"
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding LatencyStageRate, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                        <TextBlock Text="{Binding LatencyStageRemaining}"
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding LatencyStageRemaining, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                        <TextBlock Text="{Binding LatencyStageData}"
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding LatencyStageData, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                    </StackPanel>
                                </Border>

                                <!-- 7. Secondary actions. Undo is easy to find; everything
                                     else is one level down. -->
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Ayarları geri al"
                                            MinWidth="150"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding LatencyRestoreCommand}" />
                                    <Button Content="Yük altında test et"
                                            MinWidth="170"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding LatencyDeepTestCommand}" />
                                </WrapPanel>

                                <!-- What ran and what did not: the answer to "did it even
                                     try?", which used to be unanswerable from the card. -->
                                <ItemsControl ItemsSource="{Binding LatencyLanes}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MinWidth="130" />
                                                    <ColumnDefinition Width="Auto" MinWidth="90" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding State}"
                                                           Style="{StaticResource HintStyle}"
                                                           Margin="8,0,8,0" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Detail}"
                                                           Style="{StaticResource HintStyle}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Expander Style="{StaticResource AdvancedExpanderStyle}" Margin="0,12,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="Ölçüm ayrıntıları ve gelişmiş seçenekler"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Her ayar tek tek, dönüşümlü A/B turlarıyla ölçülür: ayarsız ölç, ayarı uygula, bekle, tekrar ölç, geri al — ve sıra her turda değişir. Bir ayar yalnızca kazanç turlar boyunca tekrarlandığında ve güven aralığı sıfırı dışladığında kalır. Kabul edilenlerin tamamı en sonda birlikte yeniden ölçülür; kazanç yoksa özgün değerler anında geri yüklenir." />

                                        <CheckBox Content="Ölçüm sırasında ağ kartının yeniden başlatılmasına izin ver"
                                                  Margin="0,14,0,0"
                                                  Style="{StaticResource SwitchStyle}"
                                                  IsChecked="{Binding AllowAdapterRestart, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="26,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Çoğu ağ kartı ayarı yalnız kart yeniden başlatıldığında etkinleşir. İzin verilmezse bu ayarlar hiç ölçülmez. İzin verirseniz bağlantınız işlem sırasında birkaç saniye kesilir; uzak masaüstü oturumlarında hiçbir koşulda yapılmaz." />

                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding HasLatencyEndpointChoice, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Bulunan uç noktalar (ölçülecek olanı seçin)"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       Margin="0,0,0,4" />
                                            <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                                      MinHeight="34"
                                                      MaxWidth="420"
                                                      HorizontalAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      ItemsSource="{Binding LatencyEndpoints}"
                                                      SelectedItem="{Binding SelectedLatencyEndpoint, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Display}" />
                                                            <TextBlock Text="{Binding Why}" Style="{StaticResource HintStyle}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <TextBlock Text="Uygulanan değişiklikler"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,14,0,4" />
                                        <ItemsControl ItemsSource="{Binding LatencyAppliedChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Tutulmayan değişiklikler"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,10,0,4" />
                                        <ItemsControl ItemsSource="{Binding LatencyRejectedChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,2">
                                                        <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Change, Mode=OneWay}" />
                                                        <Run Text=" — " />
                                                        <Run Text="{Binding Reason, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding LatencyPathSummary}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding LatencyPathSummary, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                        <TextBlock Text="{Binding LatencyStatusLine}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding LatencyStatusLine, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                        <TextBlock Text="Tam ölçüm raporu"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,14,0,4" />
                                        <Border Style="{StaticResource StatusPanelStyle}">
                                            <StackPanel>
                                                <ScrollViewer MaxHeight="220"
                                                              infra:NestedScrolling.BubbleWheel="True"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding LatencyResultSummary}"
                                                               Style="{StaticResource MonospaceStyle}"
                                                               TextWrapping="Wrap" />
                                                </ScrollViewer>
                                                <TextBlock Text="{Binding LatencyDataUsedSummary}"
                                                           Style="{StaticResource HintStyle}"
                                                           Margin="0,8,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="Hızlı ölçüm"
                                                    MinWidth="130"
                                                    Margin="0,0,8,8"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyTestCommand}" />
                                            <Button Content="Zorla yeniden ölç"
                                                    MinWidth="160"
                                                    Margin="0,0,8,8"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyRetestCommand}" />
                                            <Button Content="Kayıtlı sonuçları sil"
                                                    MinWidth="170"
                                                    Margin="0,0,0,8"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyClearProfilesCommand}" />
                                        </WrapPanel>

                                        <!-- Traffic Guard: the one intervention that moves
                                             loaded latency, and the one that costs upload
                                             speed. Both halves are stated. -->
                                        <TextBlock Text="Gönderim sınırı (Traffic Guard)"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,16,0,6" />
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Ev bağlantılarında en büyük gecikme artışı boştaki ping değil, siz bir şey gönderirken oluşan kuyruklanmadır. Bu seçenek, seçtiğiniz uygulamanın giden trafiğini sınırlamak için bir Windows QoS ilkesi oluşturur; birkaç aday sınır ölçülür ve en iyisi ayrı bir turda doğrulanır. Kuyruklanma ölçülerek azalmazsa ilke silinir. Yalnız bu uygulamanın oluşturduğu ilkeler yönetilir; oyununuz sınırlanmaz. İndirme yönündeki kuyruk operatörün ekipmanında oluşur ve buradan uygulanan bir sınır ona ulaşamaz." />

                                        <CheckBox Content="Yük altında testte gönderim sınırını dene"
                                                  Margin="0,12,0,0"
                                                  Style="{StaticResource SwitchStyle}"
                                                  IsChecked="{Binding TrafficGuardEnabled, Mode=TwoWay}" />

                                        <TextBlock Text="Tercih"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,12,0,4" />
                                        <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                                  MinHeight="34"
                                                  MaxWidth="320"
                                                  HorizontalAlignment="Left"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding GuardModeOptions}"
                                                  SelectedItem="{Binding SelectedGuardMode, Mode=TwoWay}" />
                                        <TextBlock Text="{Binding SelectedGuardMode.Description}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="Sınırlanacak uygulama — oyun değil, toplu aktarım yapan program"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,12,0,4" />
                                        <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                                  MinHeight="34"
                                                  MaxWidth="420"
                                                  HorizontalAlignment="Left"
                                                  IsEditable="True"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding LatencyProcesses}"
                                                  Text="{Binding TrafficGuardApplication, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Seçilen program çalışıyor olmalıdır; ilke, çalışan sürecin görüntü adı veya doğrulanmış tam yolu ile eşleştirilir." />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Gönderim hızınız (Mbit/s)"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,0,0,4" />
                                                <TextBox MinHeight="34"
                                                         Width="120"
                                                         HorizontalAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding ManualUplinkMbps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="İndirme hızınız (Mbit/s)"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,0,0,4" />
                                                <TextBox MinHeight="34"
                                                         Width="120"
                                                         HorizontalAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding ManualDownlinkMbps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding LatencyGuardSummary}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="0,14,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Yalnızca ağ kartının geri alınabilir ayarları ve bu uygulamanın kendi QoS ilkeleri değiştirilir; IP, DHCP, ağ geçidi, DNS, IPv6 ve TCP kayıt defteri ayarları ile paket yolu bu özellik tarafından değiştirilmez." />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- ===== Vodafone Sınırsız Modu =====
                             Same shape: what network you are on, what the mode is doing
                             here, one button, then the findings as cards. The raw report
                             lives under "Teknik ayrıntılar" and is never parsed. -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Vodafone Sınırsız Modu"
                                               Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0" />
                                    <CheckBox Grid.Column="1"
                                              Content="Etkin"
                                              Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Vodafone Sınırsız Modu'nu etkinleştir"
                                              IsChecked="{Binding VodafoneModeEnabled, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="{Binding VodafoneStatusLine}"
                                           Style="{StaticResource LatencyHeadlineStyle}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding HotspotStatusSeverity, Converter={StaticResource SeverityBrushConverter}}" />
                                <TextBlock Text="{Binding HotspotCheckedAt}"
                                           Style="{StaticResource HintStyle}"
                                           Margin="0,4,0,0" />

                                <Button Content="Bağlantıyı kontrol et"
                                        MinWidth="200"
                                        MinHeight="38"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Command="{Binding HotspotDiagnoseCommand}" />

                                <ProgressBar Height="3"
                                             Margin="0,12,0,0"
                                             IsIndeterminate="{Binding IsHotspotBusy}"
                                             Visibility="{Binding IsHotspotBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Background="{DynamicResource AppSubtleBackgroundBrush}"
                                             Foreground="{DynamicResource AppAccentBrush}" />

                                <!-- The findings as cards. "Desteklenmiyor",
                                     "kullanılmıyor" and "ölçülemedi" each get their own
                                     wording and colour; only a real fault is red. -->
                                <ItemsControl ItemsSource="{Binding HotspotCards}"
                                              Margin="0,14,0,0"
                                              Visibility="{Binding HasHotspotResult, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InfoTileStyle}"
                                                    MinWidth="180"
                                                    MaxWidth="320"
                                                    Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource InfoTileLabelStyle}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Value}"
                                                               Style="{StaticResource InfoTileValueStyle}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding State, Converter={StaticResource CheckStateBrushConverter}}" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               Style="{StaticResource HintStyle}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding HotspotSuggestion}"
                                           Style="{StaticResource BodyStyle}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           Visibility="{Binding HotspotSuggestion, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                <!-- The two options users confuse, side by side with the
                                     difference spelled out. -->
                                <Border Style="{StaticResource InfoTileStyle}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Bu ağda kullan"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0" />
                                                <TextBlock Style="{StaticResource HintStyle}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="Şu anda bağlı olduğunuz ağı listeye ekler. Modu kapatıp açmanız gerekmez." />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Bu ağı kaydet"
                                                    MinWidth="140"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding RememberVodafoneNetworkCommand}" />
                                        </Grid>

                                        <CheckBox Content="Kayıtlı ağlarda otomatik kontrol"
                                                  Margin="0,14,0,0"
                                                  Style="{StaticResource SwitchStyle}"
                                                  IsChecked="{Binding HotspotDiagnostics, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="26,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Kayıtlı bir ağa geçtiğinizde kontrolü kendiliğinden çalıştırır. Kapalıyken yukarıdaki düğme yine kullanılabilir." />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Kayıtlı ağlar"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,16,0,4" />

                                <TextBlock Style="{StaticResource HintStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasVodafoneNetworks, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                           Text="Henüz kayıtlı ağ yok. Telefonunuzun paylaşımına bağlıyken “Bu ağı kaydet” ile ekleyebilirsiniz." />

                                <StackPanel Visibility="{Binding HasVodafoneNetworks, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Style="{StaticResource MonoPanelStyle}" Padding="6">
                                        <ListBox Style="{StaticResource PlainListStyle}"
                                                 MaxHeight="140"
                                                 AutomationProperties.Name="Kayıtlı ağlar"
                                                 ItemsSource="{Binding VodafoneNetworks}"
                                                 SelectedItem="{Binding SelectedVodafoneNetwork, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Display}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Marker}"
                                                                   Margin="10,0,0,0"
                                                                   Style="{StaticResource HintStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintStyle}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="Modu kapatmak kayıtlı ağları silmez; bir ağı listeden çıkarmak için seçip “Seçili ağı unut” deyin." />
                                    <Button Content="Seçili ağı unut"
                                            MinWidth="150"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding ForgetVodafoneNetworkCommand}" />
                                </StackPanel>

                                <Expander Style="{StaticResource AdvancedExpanderStyle}" Margin="0,16,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="Teknik ayrıntılar"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Kontrol sıradan ağ tanılama paketleri gönderir: kalıcı ağ ayarı, paket değişikliği veya trafik sınıflandırma kuralı oluşturmaz. Tarife ve hotspot hakkı ölçümle belirlenemediği için “Bilinmiyor” olarak kalır." />

                                        <ItemsControl ItemsSource="{Binding HotspotDetails}" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="120" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Title}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   TextWrapping="Wrap" />
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Value}"
                                                                       Style="{StaticResource CaptionStyle}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{Binding State, Converter={StaticResource CheckStateBrushConverter}}" />
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Style="{StaticResource HintStyle}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Tam rapor"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,12,0,4"
                                                   Visibility="{Binding HotspotReport, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                        <Border Style="{StaticResource MonoPanelStyle}"
                                                Visibility="{Binding HotspotReport, Converter={StaticResource EmptyToCollapsedConverter}}">
                                            <ScrollViewer MaxHeight="200"
                                                          infra:NestedScrolling.BubbleWheel="True"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding HotspotReport}"
                                                           Style="{StaticResource MonospaceStyle}"
                                                           TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Only shown when an older build actually left
                                             something behind on this machine. -->
                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding IsLegacyCleanupAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="Bu bilgisayarda eski sürümden kalan hotspot ayarları bulundu. Kaldırmak güvenlidir ve kayıtlı ağlarınızı silmez." />
                                            <Button Content="Eski kalıntıları temizle"
                                                    MinWidth="190"
                                                    Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding HotspotCleanupCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Günlük ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Günlük">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIconStyle}" Data="{StaticResource IconLogGeometry}" />
                        <AccessText Text="_Günlük" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Günlük" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="{Binding LogSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Kopyala"
                                    MinWidth="110"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding CopyLogCommand}" />
                            <Button Content="Görünümü temizle"
                                    MinWidth="140"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding ClearLogCommand}" />
                            <Button Content="Klasörü aç"
                                    MinWidth="130"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding OpenLogFolderCommand}" />
                            <!-- One action instead of collecting the same evidence by
                                 hand from four screens. Read-only: it measures nothing
                                 and changes no setting. -->
                            <Button Content="Tanı raporu kaydet"
                                    MinWidth="170"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    AutomationProperties.Name="Tanı raporu kaydet"
                                    AutomationProperties.HelpText="Durumu, ölçümleri ve günlük kesitini maskelenmiş bir arşive yazar. Hiçbir yere gönderilmez."
                                    ToolTip="Durum, ölçümler ve günlük kesiti tek bir ZIP dosyasına yazılır. Ağ adı, donanım ve IP adresleri takma adlarla değiştirilir; dosya bu bilgisayarda kalır."
                                    Command="{Binding SaveDiagnosticReportCommand}" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock Grid.Row="0"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,-4"
                               TextWrapping="Wrap"
                               Style="{StaticResource SeverityStatusLineStyle}"
                               Text="{Binding DiagnosticReportStatus, Mode=OneWay}"
                               Tag="{Binding DiagnosticReportSeverity, Mode=OneWay}" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Level and search narrow the same list the copy button copies,
                             so what is on screen and what reaches the clipboard agree. -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Düzey"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource CaptionStyle}" />
                            <ComboBox Grid.Column="1"
                                      infra:NestedScrolling.IgnoreWheel="True"
                                      x:Name="LogLevelFilter"
                                      MinWidth="160"
                                      Margin="0,0,16,0"
                                      AutomationProperties.Name="Günlük düzeyi süzgeci"
                                      ItemsSource="{Binding LogLevelOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" />

                            <TextBlock Grid.Column="2"
                                       Text="Ara"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource CaptionStyle}" />
                            <TextBox Grid.Column="3"
                                     x:Name="LogSearchBox"
                                     MinWidth="180"
                                     AutomationProperties.Name="Günlükte ara"
                                     AutomationProperties.HelpText="Görünen satırları metne göre süzer"
                                     Text="{Binding LogSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="6">
                            <ListBox x:Name="LogList"
                                     Style="{StaticResource MonospaceListStyle}"
                                     ItemContainerStyle="{StaticResource DomainRowStyle}"
                                     ItemsSource="{Binding VisibleLogLines}"
                                     AutomationProperties.Name="Günlük satırları"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ======================= Footer ======================= -->
        <Border Grid.Row="2"
                Style="{StaticResource ChromeBorderStyle}"
                BorderThickness="0,1,0,0"
                Padding="20,8,20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{DynamicResource AppAccentBrush}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center">
                        <Run Text="{Binding VersionLine, Mode=OneWay}" />
                        <Run Text=" · Yerel ve doğrudan bağlantı" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="_Çıkış"
                        MinWidth="110"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="OnExitClicked" />
            </Grid>
        </Border>
    </Grid>
</Window>

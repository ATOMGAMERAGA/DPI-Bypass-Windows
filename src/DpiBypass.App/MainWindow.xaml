<Window x:Class="DpiBypass.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:DpiBypass.App.Infrastructure"
        Title="DPI Bypass"
        Width="1080"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="Assets/dpibypass.ico"
        FontFamily="Segoe UI Variable Display, Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <infra:BooleanToHiddenConverter x:Key="BoolToHiddenConverter" />
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <infra:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsedConverter" />
        <infra:SeverityToBrushConverter x:Key="SeverityBrushConverter" />
        <infra:HotspotCheckStateToBrushConverter x:Key="CheckStateBrushConverter" />
        <infra:MeasuredToOpacityConverter x:Key="MeasuredOpacityConverter" />
        <infra:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <infra:GainToBrushConverter x:Key="GainBrushConverter" />
    </Window.Resources>

    <!-- Two layers in the same window: the app, and the greeting that covers it.

         The greeting fills the content area and nothing more. The window keeps its size,
         its position and its system title bar - close, minimise and maximise stay exactly
         where they were and keep working - because everything here is inside the client
         area and nothing touches WindowState or WindowStyle. The shell is collapsed rather
         than merely covered, so keyboard focus cannot reach a control behind the greeting.
    -->
    <Grid>

    <!-- Shell: a compact top bar (brand, live protection status, primary action),
         a navigation rail on the left and a footer with version and exit. The bar,
         the rail and the footer stay transparent so Mica shows through; hairlines
         separate them from the page content. -->
    <Grid x:Name="AppShell" Style="{StaticResource AppShellStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======================= Top bar ======================= -->
        <Border Grid.Row="0"
                Style="{StaticResource ChromeBorderStyle}"
                BorderThickness="0,0,0,1"
                Padding="20,12,20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- A 256px source for a 34px slot stays sharp well past 350%
                         scaling without decoding a megapixel bitmap. -->
                    <Border Width="34"
                            Height="34"
                            Background="{DynamicResource AppAccentSoftBrush}"
                            CornerRadius="8">
                        <Image Width="26"
                               Height="26"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="Assets/dpibypass-256.png" />
                    </Border>
                    <TextBlock Text="{Binding ProductTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>

                <!-- Live protection status. Shape and colour both react to the
                     severity; the detail rides on the tooltip. -->
                <Border Grid.Column="2"
                        Style="{StaticResource StatusPillBorderStyle}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        ToolTip="{Binding StatusDetail}"
                        AutomationProperties.Name="Koruma durumu">
                    <StackPanel Orientation="Horizontal">
                        <infra:FluentIcon Style="{StaticResource StatusPillIconStyle}" />
                        <TextBlock Text="{Binding StatusHeadline}"
                                   FontSize="12.5"
                                   MaxWidth="180" TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- The primary action is reachable from every page. -->
                <Button Grid.Column="3"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Width="190"
                        VerticalAlignment="Center"
                        infra:ActionButton.Symbol="Shield"
                        Command="{Binding ToggleCommand}"
                        Content="{Binding ToggleCaption}" />
            </Grid>
        </Border>

        <!-- ======================= Body ======================= -->
        <TabControl Grid.Row="1"
                    x:Name="NavigationTabs"
                    Style="{StaticResource NavTabControlStyle}"
                    SelectionChanged="OnNavigationSelectionChanged">

            <!-- ============ Durum ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Durum">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <infra:FluentIcon Style="{StaticResource NavIconStyle}" Symbol="Shield" />
                        <AccessText Text="_Durum" Margin="{StaticResource Nav.LabelOffset}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel>

                        <!-- ===== The connection control =====
                             One ring, one button, one sentence. Everything it draws comes
                             from ConnectionFlow's current stage, so what the ring is doing
                             and what the engine is doing cannot disagree: there is no
                             timer here, no percentage, and no state the screen can invent
                             for itself. -->
                        <Border Style="{StaticResource HeroCardStyle}" Margin="0,0,0,12" Padding="20,28">
                            <StackPanel HorizontalAlignment="Center">

                                <Grid Width="196" Height="196" HorizontalAlignment="Center">
                                    <Ellipse Style="{StaticResource ConnectionRingTrackStyle}"
                                             Width="176" Height="176" />

                                    <!-- The RotateTransform is declared here rather than in
                                         the style: a Freezable in a Style setter is frozen
                                         and shared, and animating one throws. -->
                                    <Ellipse Style="{StaticResource ConnectionRingArcStyle}"
                                             Width="176" Height="176"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>

                                    <Ellipse Style="{StaticResource ConnectionRingCompleteStyle}"
                                             Width="176" Height="176" />

                                    <Button x:Name="ConnectButton"
                                            Style="{StaticResource ConnectButtonStyle}"
                                            Command="{Binding ConnectCommand}"
                                            AutomationProperties.Name="{Binding ConnectionAction}"
                                            ToolTip="{Binding ConnectionAction}" />
                                </Grid>

                                <TextBlock Text="{Binding ConnectionTitle}"
                                           Style="{StaticResource ConnectionTitleStyle}"
                                           Margin="0,20,0,0"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="Bağlantı durumu" />

                                <TextBlock Text="{Binding ConnectionDetail}"
                                           Style="{StaticResource ConnectionDetailStyle}" />

                                <!-- Its own line, because "the engine is running" and "the
                                     site actually answers" are two different facts, and one
                                     green headline for both is how a reassuring window ends
                                     up in front of a connection that is not working. -->
                                <TextBlock Text="{Binding VerificationSummary, Mode=OneWay}"
                                           Tag="{Binding VerificationSeverity, Mode=OneWay}"
                                           Style="{StaticResource SeverityStatusLineStyle}"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           MaxWidth="420"
                                           AutomationProperties.Name="Hedef site doğrulaması"
                                           AutomationProperties.LiveSetting="Polite" />

                                <!-- Cancel is only there while there is something to
                                     cancel, but its space always is: Hidden rather than
                                     Collapsed, so pressing connect does not push the rest
                                     of the card down by 50 DIP at the exact moment the
                                     user is watching it. -->
                                <Button Content="İptal et"
                                        Margin="0,14,0,0"
                                        MinWidth="120"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        infra:ActionButton.Symbol="Dismiss"
                                        IsTabStop="{Binding CanCancelConnection}"
                                        Command="{Binding CancelConnectionCommand}"
                                        Visibility="{Binding CanCancelConnection, Converter={StaticResource BoolToHiddenConverter}}" />

                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,14,0,0"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center">
                                    <Run Text="Kapsam:" />
                                    <Run Text="{Binding SelectedScope.Title, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- ===== The four facts a decision needs =====
                             Active profile, latency, stability, traffic. Each says what
                             kind of measurement it is underneath, and anything nobody
                             measured says so rather than showing a zero. -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InfoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="Etkin profil" Style="{StaticResource InfoTileLabelStyle}" />
                                    <TextBlock Text="{Binding ActiveProfileValue}" Style="{StaticResource InfoTileValueStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ActiveProfileNote}" Style="{StaticResource HintStyle}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource InfoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="Gecikme" Style="{StaticResource InfoTileLabelStyle}" />
                                    <TextBlock Text="{Binding LatencyValue}" Style="{StaticResource InfoTileValueStyle}" />
                                    <TextBlock Text="{Binding LatencyNote}" Style="{StaticResource HintStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InfoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="Bağlantı kararlılığı" Style="{StaticResource InfoTileLabelStyle}" />
                                    <TextBlock Text="{Binding StabilityValue}" Style="{StaticResource InfoTileValueStyle}" />
                                    <TextBlock Text="{Binding StabilityNote}" Style="{StaticResource HintStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource InfoTileStyle}">
                                <StackPanel>
                                    <TextBlock Text="Güncel trafik" Style="{StaticResource InfoTileLabelStyle}" />
                                    <TextBlock Text="{Binding TrafficValue}" Style="{StaticResource InfoTileValueStyle}" />
                                    <TextBlock Text="{Binding TrafficNote}" Style="{StaticResource HintStyle}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Applied, but not written down. The setting is doing what the
                             user asked for this session; the file on disk is not, and the
                             app used to say nothing at all about the difference. The icon
                             carries the meaning as well as the colour. -->
                        <Border Style="{StaticResource NoticeCardStyle}"
                                Margin="0,0,0,12"
                                AutomationProperties.Name="Ayar kaydetme uyarısı"
                                Visibility="{Binding SettingsSaveFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <infra:FluentIcon Grid.Column="0"
                                                  Symbol="Warning"
                                                  Filled="True"
                                                  Size="{StaticResource IconSize.Body}"
                                                  Margin="0,0,12,0"
                                                  Foreground="{DynamicResource AppWarningBrush}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource NoticeTextStyle}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Text="{Binding SettingsSaveWarning, Mode=OneWay}" />
                                <Button Grid.Column="2"
                                        Content="Yeniden kaydet"
                                        MinWidth="130"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding RetrySaveCommand}" />
                            </Grid>
                        </Border>

                        <!-- Which network this is and who runs it. One line rather than
                             two tiles: it is context for the four facts above, not a fifth
                             fact, and the page it belongs to is "Ağ ve yöntem". -->
                        <TextBlock Style="{StaticResource CaptionStyle}" Margin="2,0,0,16">
                            <Run Text="Ağ:" />
                            <Run Text="{Binding NetworkName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text=" · " />
                            <Run Text="Operatör:" />
                            <Run Text="{Binding IspSummary, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>

                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,12">
                            <StackPanel>
                                <TextBlock Text="Bağlantı testi" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="Gerçek bir TLS el sıkışması yapılır ve sertifika doğrulanır. Yalnızca bağlantı kurulması değil, araya girilmediği de kontrol edilir." />

                                <WrapPanel Margin="0,12,0,2">
                                    <Button Content="discord.com testi"
                                            MinWidth="150"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding TestCommand}" />
                                    <Button Content="Tüm Discord adresleri"
                                            MinWidth="180" Margin="0,0,0,8"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding TestAllCommand}" />
                                </WrapPanel>

                                <Border Style="{StaticResource MonoPanelStyle}">
                                    <TextBlock Text="{Binding ProbeSummary}" Style="{StaticResource MonospaceStyle}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Motor sayaçları" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding EngineCounters}" Style="{StaticResource MonospaceStyle}" />
                                <TextBlock Text="{Binding DnsSummary}" Style="{StaticResource MonospaceStyle}" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,12,0,0"
                                           Text="Yalnızca bağlantının ilk veri paketi işlenir. Ping, ses trafiği ve indirme hızı çekirdek süzgecine hiç girmediği için etkilenmez." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Kapsam ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Kapsam">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <infra:FluentIcon Style="{StaticResource NavIconStyle}" Symbol="Target" />
                        <AccessText Text="_Kapsam" Margin="{StaticResource Nav.LabelOffset}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <infra:DeferredTabContent.Template>
                    <DataTemplate>
                <ScrollViewer Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel>
                        <TextBlock Text="Ne korunsun?" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Margin="0,0,0,14"
                                   Text="Kapsam ne kadar dar olursa sisteme etkisi de o kadar az olur. Discord uygulaması, çalışan süreç adına göre tanınır." />

                        <ListBox Style="{StaticResource ChoiceListStyle}"
                                 ItemContainerStyle="{StaticResource ChoiceCardStyle}"
                                 ItemsSource="{Binding ScopeOptions}"
                                 SelectedItem="{Binding SelectedScope, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            <Border Style="{StaticResource RecommendedTagBorderStyle}"
                                                    Margin="9,0,0,0"
                                                    Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="Önerilen" Style="{StaticResource RecommendedTagTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Style="{StaticResource CardStyle}" Margin="0,8,0,12">
                            <StackPanel>
                                <TextBlock Text="Bu bilgisayarda bulunanlar" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Discord" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding DiscordSummary}" Style="{StaticResource BodyStyle}" Margin="0,0,0,12" />
                                <TextBlock Text="Tarayıcılar" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding BrowserSummary}" Style="{StaticResource BodyStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="QUIC el sıkışmalarını engelle" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="QUIC, alan adını şifreli taşıdığı için burada uygulanan yöntemler ona ulaşamaz. Yeni QUIC el sıkışmaları reddedilirse tarayıcı saniyeler içinde TCP'ye döner ve koruma devreye girer. Yalnızca korunan programlar etkilenir." />
                                <CheckBox Content="Korunan programlar için QUIC'i engelle (önerilen)"
                                          Margin="0,12,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding BlockQuic, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    </DataTemplate>
                </infra:DeferredTabContent.Template>
            </TabItem>

            <!-- ============ Siteler ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Siteler">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <infra:FluentIcon Style="{StaticResource NavIconStyle}" Symbol="Globe" />
                        <AccessText Text="_Siteler" Margin="{StaticResource Nav.LabelOffset}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <infra:DeferredTabContent.Template>
                    <DataTemplate>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Korunan siteler" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Bu listedeki alan adlarına giden bağlantılarda atlatma uygulanır. Alt alan adları kendiliğinden kapsanır." />
                        <TextBlock Text="{Binding DomainSummary}" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,12">
                        <StackPanel>
                            <TextBlock Text="Alan adı ekle" Style="{StaticResource SectionTitleStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         MinHeight="34"
                                         VerticalContentAlignment="Center"
                                         Padding="10,7"
                                         AutomationProperties.Name="Eklenecek alan adı"
                                         Text="{Binding NewDomain, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Content="Ekle"
                                        MinWidth="100"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        infra:ActionButton.Symbol="Add"
                                        Command="{Binding AddDomainCommand}" />
                                <Button Grid.Column="2"
                                        Content="Seçileni çıkar"
                                        MinWidth="140"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Command="{Binding RemoveDomainCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding DomainStatus}"
                                       Style="{StaticResource StatusLineStyle}"
                                       Margin="0,8,0,0" />

                            <CheckBox Content="Yeni engelli siteleri kendiliğinden bul (önerilen)"
                                      Margin="0,14,0,0"
                                      Style="{StaticResource SwitchStyle}"
                                      IsChecked="{Binding AutoDiscover, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource CaptionStyle}"
                                       Margin="26,4,0,0"
                                       Text="Açtığınız yeni bir alan adı atlatmasız açılmayıp atlatmayla açılıyorsa sessizce sınanır ve kalıcı olarak listeye eklenir." />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="4,4,4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox MinHeight="32"
                                             VerticalContentAlignment="Center"
                                             Padding="30,6,8,6"
                                             AutomationProperties.Name="Alan adı ara"
                                             Text="{Binding DomainFilter, UpdateSourceTrigger=PropertyChanged}" />
                                    <infra:FluentIcon Symbol="Search"
                                                      Size="{StaticResource IconSize.Small}"
                                                      HorizontalAlignment="Left"
                                                      Margin="10,0,0,0"
                                                      IsHitTestVisible="False"
                                                      Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </Grid>
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostIconButtonStyle}"
                                        Margin="6,0,0,0"
                                        Command="{Binding ClearDomainFilterCommand}"
                                        ToolTip="Aramayı temizle"
                                        AutomationProperties.Name="Aramayı temizle">
                                    <infra:FluentIcon Symbol="Dismiss"
                                                      Size="{StaticResource IconSize.Small}"
                                                      Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </Button>
                            </Grid>

                            <!-- The empty state sits over the list and only shows
                                 when the (possibly filtered) view has no rows. -->
                            <Grid Grid.Row="1">
                                <ListBox Style="{StaticResource PlainListStyle}"
                                         ItemContainerStyle="{StaticResource DomainRowStyle}"
                                         ItemsSource="{Binding FilteredDomains}"
                                         SelectedItem="{Binding SelectedDomain, Mode=TwoWay}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Domain}"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                                <Border Grid.Column="1" Style="{StaticResource TagStyle}">
                                                    <TextBlock Text="{Binding OriginLabel}" Style="{StaticResource TagTextStyle}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border IsHitTestVisible="False"
                                        Padding="12,18"
                                        Visibility="{Binding DomainsViewEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="Gösterilecek alan adı yok."
                                                   Style="{StaticResource BodyStyle}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="Aramayı temizleyin ya da yukarıdaki alandan yeni bir alan adı ekleyin."
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                    </DataTemplate>
                </infra:DeferredTabContent.Template>
            </TabItem>

            <!-- ============ Ağ ve yöntem ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Ağ ve yöntem">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <infra:FluentIcon Style="{StaticResource NavIconStyle}" Symbol="TopSpeed" />
                        <AccessText Text="Ağ ve _yöntem" Margin="{StaticResource Nav.LabelOffset}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <infra:DeferredTabContent.Template>
                    <DataTemplate>
                <ScrollViewer Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bulunduğunuz ağ" Style="{StaticResource SectionTitleStyle}" />

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource InfoTileStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Ağ adı" Style="{StaticResource InfoTileLabelStyle}" />
                                            <TextBlock Text="{Binding NetworkName}" Style="{StaticResource InfoTileValueStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource InfoTileStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Algılanan operatör" Style="{StaticResource InfoTileLabelStyle}" />
                                            <TextBlock Text="{Binding IspSummary}" Style="{StaticResource InfoTileValueStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Text="Ağ değiştiğinde (örneğin başka bir Wi-Fi adına geçtiğinizde) yeni ağ için yöntem arka planda yeniden bulunur. Daha önce çalışan yöntem hatırlanır ve önce o denenir." />

                                <CheckBox Content="Ağ değişince yöntemi kendiliğinden yeniden ara"
                                          Margin="0,10,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding AutoTuneOnNetworkChange, Mode=TwoWay}" />

                                <TextBlock Text="Operatör" Style="{StaticResource FieldLabelStyle}" Margin="0,14,0,4" />
                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding IspOptions}"
                                          SelectedItem="{Binding SelectedIsp, Mode=TwoWay}"
                                          MinWidth="320"
                                          MinHeight="34"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Aşma yöntemi" Style="{StaticResource SectionTitleStyle}" />

                                <TextBlock Text="Etkin yöntem" Style="{StaticResource FieldLabelStyle}" />
                                <TextBlock Text="{Binding StrategySummary}"
                                           Style="{StaticResource InfoTileValueStyle}"
                                           Margin="0,0,0,8" />

                                <!-- Why this one, measured when, and how much was measured.
                                     The third is the one most easily left out and the one
                                     that keeps the other two honest: a choice made from
                                     reachability and connect times is a real choice and is
                                     not the same as one made after measuring throughput,
                                     and the line says which. -->
                                <Border Style="{StaticResource InfoTileStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectionRationale, Mode=OneWay}"
                                                   Style="{StaticResource BodyStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Seçim gerekçesi"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <TextBlock Text="{Binding SelectionConfidenceLabel, Mode=OneWay}"
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource HintStyle}" Margin="0,2,0,0">
                                            <Run Text="Ölçüm zamanı:" />
                                            <Run Text="{Binding SelectionMeasuredAt, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Which candidates were measured and dropped, and why.
                                     "It picked the slow one" is a complaint that can only be
                                     answered with the list of what else was tried. -->
                                <Expander Style="{StaticResource AdvancedExpanderStyle}"
                                          Margin="0,0,0,12"
                                          Visibility="{Binding SelectionRejections.Count, Converter={StaticResource CountToVisibilityConverter}}">
                                    <Expander.Header>
                                        <TextBlock Text="Elenen adaylar" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding SelectionRejections}"
                                                  AutomationProperties.Name="Elenen adaylar">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource InfoTileStyle}" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding StrategyName}"
                                                                   Style="{StaticResource BodyStyle}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Reason}"
                                                                   Style="{StaticResource HintStyle}"
                                                                   Margin="0,3,0,0"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>

                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding StrategyOptions}"
                                          SelectedItem="{Binding SelectedStrategy, Mode=TwoWay}"
                                          MinWidth="380"
                                          MinHeight="34"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Text="{Binding SelectedStrategyDescription}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,8,0,0" />

                                <!-- Two buttons, because they cost different things. The
                                     first measures reach, stability and latency and moves
                                     almost nothing; the second adds a transfer per
                                     candidate and says how much data that is before it is
                                     pressed. A user finding out what a button spent after
                                     pressing it is not a choice they made. -->
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Content="Yeniden tara"
                                            MinWidth="150"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            infra:ActionButton.Symbol="ArrowClockwise"
                                            Command="{Binding RetuneCommand}" />
                                    <Button Content="Hızı da ölçerek tara"
                                            MinWidth="190"
                                            Margin="0,0,8,8"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            infra:ActionButton.Symbol="TopSpeed"
                                            ToolTip="{Binding ThroughputCostSummary}"
                                            AutomationProperties.Name="Hızı da ölçerek yeniden tara"
                                            Command="{Binding RetuneWithSpeedCommand}" />
                                </WrapPanel>

                                <TextBlock Style="{StaticResource HintStyle}"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap">
                                    <Run Text="Hız ölçümü her aday için gerçek bir aktarım yapar." />
                                    <Run Text="{Binding ThroughputCostSummary, Mode=OneWay}" />
                                </TextBlock>

                                <CheckBox Content="Her otomatik taramada hızı da ölç"
                                          Margin="0,0,0,10"
                                          Style="{StaticResource SwitchStyle}"
                                          AutomationProperties.Name="Her otomatik taramada hızı da ölç"
                                          IsChecked="{Binding MeasureThroughputDuringTuning, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource HintStyle}"
                                           Margin="26,0,0,10"
                                           TextWrapping="Wrap"
                                           Text="Kapalıyken tarama erişim, kararlılık ve gecikmeyi ölçer; hız ölçülmez ve sonuçta &quot;hız testi yapılmadı&quot; yazar. Ağ her değiştiğinde tarama çalıştığı için bu seçenek mobil veri kullanımını artırabilir." />

                                <StackPanel Orientation="Horizontal">
                                    <!-- Real tuning progress: only while the sweep runs. -->
                                    <ProgressBar Width="90"
                                                 Height="3"
                                                 Margin="0,0,0,0"
                                                 VerticalAlignment="Center"
                                                 IsIndeterminate="{Binding IsTuning}"
                                                 Visibility="{Binding IsTuning, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 Background="{DynamicResource AppSubtleBackgroundBrush}"
                                                 Foreground="{DynamicResource AppAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding TuningStatus}"
                                           Style="{StaticResource CaptionStyle}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Son korunan adresler" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox Style="{StaticResource MonospaceListStyle}"
                                         ItemContainerStyle="{StaticResource DomainRowStyle}"
                                         ItemsSource="{Binding ProtectedHosts}"
                                         MaxHeight="200" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    </DataTemplate>
                </infra:DeferredTabContent.Template>
            </TabItem>

            <!-- ============ DNS ve ayarlar ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="DNS ve ayarlar">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <infra:FluentIcon Style="{StaticResource NavIconStyle}" Symbol="Options" />
                        <AccessText Text="DNS ve _ayarlar" Margin="{StaticResource Nav.LabelOffset}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <infra:DeferredTabContent.Template>
                    <DataTemplate>
                <ScrollViewer Style="{StaticResource PageSurfaceStyle}">
                    <StackPanel>
                        <!-- This page is long enough that the three sections people come
                             here for - ping, the send-rate cap, Vodafone mode - are below
                             the fold on a 1366x768 screen at 125%. These jump to them
                             rather than adding another level of navigation to learn. They
                             are buttons, so they are in the tab order and can be reached
                             from the keyboard like everything else. -->
                        <WrapPanel Margin="0,0,0,12" AutomationProperties.Name="Bölüme git">
                            <TextBlock Text="Bölüme git:"
                                       Style="{StaticResource CaptionStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,8" />
                            <Button Content="Ping düşürme"
                                    Margin="0,0,8,8"
                                    MinWidth="130"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Tag="{Binding ElementName=LatencySection}"
                                    Click="OnJumpToSection" />
                            <Button Content="Gönderim sınırı"
                                    Margin="0,0,8,8"
                                    MinWidth="140"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Tag="{Binding ElementName=TrafficGuardSection}"
                                    Click="OnJumpToSection" />
                            <Button Content="Vodafone Sınırsız Modu"
                                    Margin="0,0,8,8"
                                    MinWidth="190"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Tag="{Binding ElementName=VodafoneSection}"
                                    Click="OnJumpToSection" />
                        </WrapPanel>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Alan adı çözümleme" Style="{StaticResource SectionTitleStyle}" />
                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding DnsOptions}"
                                          SelectedItem="{Binding SelectedDns, Mode=TwoWay}"
                                          MinWidth="380"
                                          MinHeight="34"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Text="{Binding SelectedDnsDescription}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,8,0,12" />
                                <Border Style="{StaticResource MonoPanelStyle}">
                                    <TextBlock Text="{Binding DnsSummary}" Style="{StaticResource MonospaceStyle}" />
                                </Border>
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,12,0,0"
                                           Text="Çözümleyicilere IP adresiyle bağlanılır; böylece TLS içinde alan adı hiç gönderilmez ve DNS trafiği alan adına göre süzülemez. Koruma kapatıldığında özgün DNS ayarlarınız geri yüklenir." />
                            </StackPanel>
                        </Border>

                        <!-- ===== Lunar Client reklam engeli =====
                             Above the fold on purpose: it is a switch, not a section, and
                             it belongs next to name resolution because that is the only
                             thing it touches. Nothing here is on the packet path. -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Lunar Client reklam engeli"
                                               Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center" />

                                    <CheckBox Grid.Column="1"
                                              Content="Etkin"
                                              Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Lunar Client reklam engelini etkinleştir"
                                              IsChecked="{Binding BlockLunarAds, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,10,0,0"
                                           Text="Lunar Client başlatıcısının sağ alt köşesindeki reklam alanını Overwolf doldurur. Açıldığında yalnızca reklam, ölçüm ve telemetri sunucularının adları hem hosts dosyasında hem uygulamanın kendi çözümleyicisinde sıfır adrese bağlanır: istek ağa hiç çıkmadığı için ping artmaz, indirme hızı düşmez." />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,6,0,0"
                                           Text="Lunar Client'ın giriş, kozmetik ve sunucu bağlantıları listede değildir; oyuna bağlanmanız etkilenmez. Vodafone Sınırsız Modu ile birlikte çalışır, o modun TTL kuralına dokunmaz." />

                                <TextBlock Text="{Binding LunarAdBlockLine}"
                                           Style="{StaticResource StatusLineStyle}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding LunarAdBlockSeverity, Converter={StaticResource SeverityBrushConverter}}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Başlangıç ve pencere" Style="{StaticResource SectionTitleStyle}" />
                                <CheckBox Content="Windows açılışında başlat"
                                          Margin="0,0,0,4"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="26,0,0,10"
                                           Text="Windows Başlangıç Uygulamaları listesine eklenir; yükseltilmiş görev sayesinde her açılışta yönetici onayı sorulmaz." />
                                <CheckBox Content="Açılışta pencereyi göstermeden tepside başla"
                                          Margin="0,0,0,4"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding StartMinimised, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="26,0,0,10"
                                           Text="Tepsideyken simgeye çift tıklayarak ya da kısayolu yeniden çalıştırarak pencereyi geri getirebilirsiniz." />
                                <CheckBox Content="Uygulama açılırken korumayı da başlat"
                                          Margin="0,0,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding StartEngineOnLaunch, Mode=TwoWay}" />
                                <CheckBox Content="Pencere kapatıldığında tepsiye küçült"
                                          Margin="0,10,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          IsChecked="{Binding MinimiseToTrayOnClose, Mode=TwoWay}" />

                                <CheckBox Content="Açılışta karşılamayı göster"
                                          Margin="0,10,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          AutomationProperties.Name="Açılışta karşılamayı göster"
                                          IsChecked="{Binding ShowWelcomeOnStartup, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="26,4,0,0"
                                           Text="Uygulamayı elle açtığınızda kısa bir karşılama görürsünüz. Windows ile sessiz başlangıçta ve tepsiden geri dönüşte gösterilmez." />

                                <Button Content="Tanıtımı yeniden göster"
                                        MinWidth="200"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        infra:ActionButton.Symbol="BookOpen"
                                        AutomationProperties.Name="Tanıtımı yeniden göster"
                                        Command="{Binding ShowWelcomeTourCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- ===== Görünüm =====
                             Mica and Acrylic are not two intensities of the same thing and
                             the descriptions say which is which: Mica takes its colour from
                             the wallpaper and is opaque, Acrylic is real translucency and
                             shows the windows behind. Acrylic across a whole window is a
                             deliberate departure from Microsoft's guidance rather than an
                             upgrade, so it is offered and explained rather than defaulted
                             to. Whatever the machine could actually deliver is reported
                             underneath, in words, with the evidence a step further down. -->
                        <Border x:Name="AppearanceSection" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Görünüm" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,0,0,10"
                                           Text="Pencere arka planının nasıl çizileceğini seçin. Okunabilirlik her seçenekte aynıdır; değişen yalnızca arka plandır." />

                                <ListBox Style="{StaticResource ChoiceListStyle}"
                                         ItemsSource="{Binding AppearanceOptions}"
                                         SelectedItem="{Binding SelectedAppearance, Mode=TwoWay}"
                                         AutomationProperties.Name="Pencere görünümü">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChoiceCardStyle}" />
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Display}"
                                                           Style="{StaticResource BodyStyle}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource CaptionStyle}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{Binding AppearanceStatus, Mode=OneWay}"
                                           Tag="{Binding AppearanceStatusSeverity, Mode=OneWay}"
                                           Style="{StaticResource SeverityStatusLineStyle}"
                                           Margin="0,4,0,0"
                                           AutomationProperties.Name="Uygulanan pencere görünümü"
                                           AutomationProperties.LiveSetting="Polite" />

                                <CheckBox Content="Uygulama içi hareketi azalt"
                                          Margin="0,14,0,0"
                                          Style="{StaticResource SwitchStyle}"
                                          AutomationProperties.Name="Uygulama içi hareketi azalt"
                                          IsChecked="{Binding ReduceMotion, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="26,4,0,0"
                                           Text="Bağlantı halkası ve sayfa geçişleri gibi animasyonlar kapanır. Windows'un kendi animasyon tercihi kapalıysa bu ayardan bağımsız olarak zaten uygulanır." />

                                <Expander Style="{StaticResource AdvancedExpanderStyle}" Margin="0,14,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="Teknik ayrıntılar" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                    </Expander.Header>
                                    <Border Style="{StaticResource MonoPanelStyle}">
                                        <TextBlock Text="{Binding AppearanceEvidence, Mode=OneWay}"
                                                   Style="{StaticResource MonospaceStyle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Pencere görünümü tanılama bilgisi" />
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Düzenli denetim" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Style="{StaticResource CaptionStyle}"
                                           Margin="0,0,0,10"
                                           Text="Seçili yöntem belirli aralıklarla yeniden sınanır. Operatör kural değiştirdiğinde yeni bir yöntem kendiliğinden aranır." />
                                <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                          ItemsSource="{Binding RecheckOptions}"
                                          SelectedItem="{Binding SelectedRecheck, Mode=TwoWay}"
                                          MinWidth="260"
                                          MinHeight="34"
                                          HorizontalAlignment="Left"
                                          VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- ===== Ping optimizasyonu =====
                             One switch, three numbers, one sentence. Turning it on picks
                             the target, measures, tries the settings that apply and keeps
                             only what it could verify; there is no mode to choose first
                             and no test to run afterwards. Everything technical - which
                             endpoint, which candidates, p95, the lanes - is behind the
                             expander at the bottom, because a person turning this on is
                             asking one question and the three figures are its answer. -->
                        <Border x:Name="LatencySection" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>

                                <!-- 1. Title and the one control. The switch is the user's
                                     preference; the status word beside it is what actually
                                     happened, and the two are deliberately not the same
                                     thing - "Açık" does not mean "your ping went down". -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Ping optimizasyonu"
                                                       Style="{StaticResource SectionTitleStyle}"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Center" />
                                            <Border Style="{StaticResource BetaBadgeStyle}" VerticalAlignment="Center">
                                                <TextBlock Text="BETA" Style="{StaticResource BetaBadgeTextStyle}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="PingStatusWord"
                                                   Text="{Binding PingCard.Status}"
                                                   Style="{StaticResource PingStatusWordStyle}"
                                                   Margin="0,4,0,0"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>

                                    <CheckBox Grid.Column="1"
                                              x:Name="PingSwitch"
                                              Content="{Binding PingCard.Status}"
                                              Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Ping optimizasyonu"
                                              IsChecked="{Binding LowLatencyMode, Mode=TwoWay}" />
                                </Grid>

                                <!-- 2. Önce / Sonra / Kazanç. The same statistic of the
                                     same comparison on both sides, so the difference is
                                     the difference the settings made. A value nobody
                                     measured is an em dash and never a zero. -->
                                <Grid x:Name="PingFigures" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource PingFigureTileStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Önce" Style="{StaticResource PingFigureLabelStyle}" />
                                            <TextBlock Text="{Binding PingCard.Before}"
                                                       Style="{StaticResource PingFigureStyle}"
                                                       AutomationProperties.Name="Önceki ping" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource PingFigureTileStyle}" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Sonra" Style="{StaticResource PingFigureLabelStyle}" />
                                            <TextBlock Text="{Binding PingCard.After}"
                                                       Style="{StaticResource PingFigureStyle}"
                                                       AutomationProperties.Name="Sonraki ping" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource PingFigureTileStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Kazanç" Style="{StaticResource PingFigureLabelStyle}" />
                                            <TextBlock Text="{Binding PingCard.Gain}"
                                                       Style="{StaticResource PingGainStyle}"
                                                       AutomationProperties.Name="Kazanç" />
                                            <TextBlock Text="{Binding PingCard.Percent}"
                                                       Style="{StaticResource PingPercentStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 3. What was measured and when, labelled so a past
                                     comparison is never read as a live ping. -->
                                <TextBlock Text="{Binding PingCard.TargetLine}"
                                           Style="{StaticResource HintStyle}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding PingCard.MeasuredAtLine}"
                                           Style="{StaticResource HintStyle}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap" />

                                <!-- 4. One sentence about what happened. -->
                                <TextBlock Text="{Binding PingCard.Explanation}"
                                           Style="{StaticResource BodyStyle}"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite" />

                                <!-- A steadier connection is its own result and gets its
                                     own line. It is never added to the ping gain. -->
                                <TextBlock Text="{Binding PingCard.StabilityNote}"
                                           Style="{StaticResource CaptionStyle}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding PingCard.StabilityNote, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                <!-- The current idle ping, labelled apart from the pair
                                     above it: that is the history of one comparison, this
                                     is what the connection reads now. -->
                                <TextBlock Margin="0,10,0,0" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap">
                                    <Run Text="Şu anki ping:" />
                                    <Run Text="{Binding PingCard.CurrentPing, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>

                                <!-- This slot stays in the layout while idle: starting a run
                                     must not push the results and actions out of view. -->
                                <Grid x:Name="LatencyProgressSlot" Height="80" Margin="0,8,0,0">
                                    <Border x:Name="LatencyProgressPanel" Style="{StaticResource StatusPanelStyle}"
                                            Padding="12,8"
                                            Visibility="{Binding IsLatencyProgressVisible, Converter={StaticResource BoolToHiddenConverter}}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="3" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LatencyProgressLabel" Text="{Binding LatencyProgressTitle}"
                                                       Style="{StaticResource BodyStyle}" FontWeight="SemiBold"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding LatencyProgressTitle}" VerticalAlignment="Center"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <Button Grid.Column="1" Grid.RowSpan="3" Content="İptal et"
                                                    Margin="8,0,0,0" Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyCancelCommand}" />
                                            <TextBlock Grid.Row="1" Text="{Binding LatencyStageInstruction}"
                                                       Style="{StaticResource HintStyle}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding LatencyStageInstruction}" />
                                            <TextBlock Grid.Row="2" Text="{Binding LatencyElapsed}"
                                                       Style="{StaticResource HintStyle}" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Grid.Row="3" Grid.ColumnSpan="2" Height="3"
                                                         IsIndeterminate="{Binding IsLatencyProgressVisible}"
                                                         Background="{DynamicResource AppSubtleBackgroundBrush}"
                                                         Foreground="{DynamicResource AppAccentBrush}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="LatencyIdleHint" Text="Açtığınızda hedefi kendisi seçer, ölçer ve yalnız doğruladığı iyileştirmeleri uygular."
                                               Style="{StaticResource HintStyle}" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsLatencyProgressVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                                </Grid>

                                <Expander Style="{StaticResource AdvancedExpanderStyle}" Margin="0,12,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="Ayrıntılar"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0" />
                                    </Expander.Header>
                                    <StackPanel>

                                        <!-- The next step the engine worked out. It lives
                                             here rather than on the card because turning
                                             the switch on already runs the whole sequence;
                                             this is for the cases where somebody wants to
                                             re-run one part of it by hand. -->
                                        <Button x:Name="LatencyPrimaryButton" Content="{Binding LatencyPrimaryAction}"
                                                Width="240"
                                                MinHeight="38"
                                                Margin="0,16,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryActionButtonStyle}"
                                                infra:ActionButton.Symbol="TopSpeed"
                                                Command="{Binding LatencyPrimaryCommand}" />


                                        <!-- What to measure. Automatic by default, which is
                                             what the card uses and what almost everybody
                                             should leave it on; the explicit kinds are here
                                             for somebody who knows which endpoint they
                                             want. -->
                                        <TextBlock Text="Ne ölçülsün?"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,16,0,4" />
                                        <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                                  ItemsSource="{Binding LatencyTargetOptions}"
                                                  SelectedItem="{Binding SelectedLatencyTarget, Mode=TwoWay}"
                                                  MinWidth="260"
                                                  MinHeight="34"
                                                  MaxWidth="420"
                                                  HorizontalAlignment="Left"
                                                  AutomationProperties.Name="Ölçüm hedefi"
                                                  VerticalContentAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedLatencyTarget.Description}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />

                                        <StackPanel Margin="0,10,0,0"
                                                    Visibility="{Binding IsCustomLatencyTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBox MinHeight="34"
                                                     Width="420"
                                                     MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                                     HorizontalAlignment="Left"
                                                     VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="Sunucu adresi"
                                                     Text="{Binding LatencyCustomTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="Örnek: sunucu.com · sunucu.com:25565 · udp://1.2.3.4:7777"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <Grid Margin="0,10,0,0"
                                              Visibility="{Binding IsApplicationLatencyTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MaxWidth="420" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                                      Grid.Column="0"
                                                      MinHeight="34"
                                                      VerticalContentAlignment="Center"
                                                      AutomationProperties.Name="Ölçülecek uygulama"
                                                      ItemsSource="{Binding LatencyProcesses}"
                                                      SelectedItem="{Binding SelectedLatencyProcess, Mode=TwoWay}" />
                                            <Button Grid.Column="1"
                                                    Content="Yenile"
                                                    MinWidth="90"
                                                    Margin="8,0,0,0"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    infra:ActionButton.Symbol="ArrowClockwise"
                                                    Command="{Binding RefreshLatencyProcessesCommand}" />
                                        </Grid>

                                        <StackPanel Margin="0,8,0,0"
                                                    Visibility="{Binding IsValorantLatencyTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Button Content="VALORANT Network RTT alanını seç"
                                                    MinWidth="250"
                                                    MinHeight="34"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    IsEnabled="{Binding CanSelectValorantRttRegion}"
                                                    Click="SelectValorantRttRegion_Click" />
                                            <TextBlock Text="{Binding ValorantRttRegionSummary}"
                                                       Style="{StaticResource HintStyle}"
                                                       Margin="0,5,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- The error belongs to the field above it, and the
                                             buttons are disabled while it is showing. -->
                                        <TextBlock Text="{Binding LatencyTargetError}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Assertive"
                                                   Visibility="{Binding LatencyTargetError, Converter={StaticResource EmptyToCollapsedConverter}}"
                                                   Foreground="{DynamicResource AppDangerBrush}" />
                                <!-- 4. The numbers. A card with nothing behind it says so
                                             and dims; it never prints a zero nobody measured. -->
                                        <ItemsControl x:Name="LatencyResultCards" ItemsSource="{Binding LatencyCards}" Margin="0,16,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource InfoTileStyle}"
                                                            MinHeight="108"
                                                            Margin="0,0,8,8"
                                                            Opacity="{Binding Measured, Converter={StaticResource MeasuredOpacityConverter}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       Style="{StaticResource InfoTileLabelStyle}"
                                                                       TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Value}"
                                                                       Style="{StaticResource InfoTileValueStyle}" />
                                                            <TextBlock Text="{Binding Note}"
                                                                       Style="{StaticResource HintStyle}"
                                                                       Margin="0,2,0,0"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding Note, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Style="{StaticResource HintStyle}" TextWrapping="Wrap">
                                            <Run Text="{Binding LatencyTargetSummary, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LatencyMeasuredAt, Mode=OneWay}" />
                                        </TextBlock>

                                        <!-- 5. One sentence about what happened, one about what
                                             to do next. Nothing else competes with them. -->
                                        <TextBlock Text="{Binding LatencySuggestion}"
                                                   Style="{StaticResource BodyStyle}"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Visibility="{Binding LatencySuggestion, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                        <!-- 7. Secondary actions. Undo is easy to find; everything
                                             else is one level down. -->
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="Ayarları geri al"
                                                    MinWidth="150"
                                                    Margin="0,0,8,8"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyRestoreCommand}" />
                                            <Button Content="Yük altında test et"
                                                    MinWidth="170"
                                                    Margin="0,0,8,8"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyDeepTestCommand}" />
                                        </WrapPanel>

                                        <!-- What ran and what did not: the answer to "did it even
                                             try?", which used to be unanswerable from the card. -->
                                        <ItemsControl ItemsSource="{Binding LatencyLanes}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="130" />
                                                            <ColumnDefinition Width="Auto" MinWidth="90" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Title}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding State}"
                                                                   Style="{StaticResource HintStyle}"
                                                                   Margin="8,0,8,0" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Detail}"
                                                                   Style="{StaticResource HintStyle}"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>


                                        <TextBlock Text="{Binding LatencyStageInstruction}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,8,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding LatencyStageInstruction, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                        <TextBlock Text="{Binding LatencyStageRate}"
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding LatencyStageRate, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                        <TextBlock Text="{Binding LatencyStageRemaining}"
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding LatencyStageRemaining, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                        <TextBlock Text="{Binding LatencyStageData}"
                                                   Style="{StaticResource HintStyle}"
                                                   Margin="0,2,0,0"
                                                   Visibility="{Binding LatencyStageData, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                        <!-- Where the run has got to. Each row carries a word for
                                             its state as well as a colour, so the sequence reads
                                             the same with colour vision differences or in a
                                             screen reader. -->
                                        <Border Style="{StaticResource StatusPanelStyle}" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Ölçüm adımları"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,0,0,6" />
                                                <ItemsControl ItemsSource="{Binding LatencyFlow}"
                                                              AutomationProperties.Name="Ölçüm adımları">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Ordinal}"
                                                                           Style="{StaticResource HintStyle}"
                                                                           MinWidth="18"
                                                                           VerticalAlignment="Top" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding StateLabel}"
                                                                           Style="{StaticResource SeverityStatusLineStyle}"
                                                                           Tag="{Binding Severity}"
                                                                           MinWidth="96"
                                                                           VerticalAlignment="Top" />
                                                                <TextBlock Grid.Column="2"
                                                                           Style="{StaticResource CaptionStyle}"
                                                                           TextWrapping="Wrap">
                                                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                                    <Run Text=" · " />
                                                                    <Run Text="{Binding Detail, Mode=OneWay}" />
                                                                </TextBlock>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>


                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Her ayar tek tek, dönüşümlü A/B turlarıyla ölçülür: ayarsız ölç, ayarı uygula, bekle, tekrar ölç, geri al — ve sıra her turda değişir. Bir ayar yalnızca kazanç turlar boyunca tekrarlandığında ve güven aralığı sıfırı dışladığında kalır. Kabul edilenlerin tamamı en sonda birlikte yeniden ölçülür; kazanç yoksa özgün değerler anında geri yüklenir." />

                                        <CheckBox Content="Ölçüm sırasında ağ kartının yeniden başlatılmasına izin ver"
                                                  Margin="0,14,0,0"
                                                  Style="{StaticResource SwitchStyle}"
                                                  IsChecked="{Binding AllowAdapterRestart, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="26,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Çoğu ağ kartı ayarı yalnız kart yeniden başlatıldığında etkinleşir. İzin verilmezse bu ayarlar hiç ölçülmez. İzin verirseniz bağlantınız işlem sırasında birkaç saniye kesilir; uzak masaüstü oturumlarında hiçbir koşulda yapılmaz." />

                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding HasLatencyEndpointChoice, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="Bulunan uç noktalar (ölçülecek olanı seçin)"
                                                       Style="{StaticResource FieldLabelStyle}"
                                                       Margin="0,0,0,4" />
                                            <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                                      MinHeight="34"
                                                      MaxWidth="420"
                                                      HorizontalAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      ItemsSource="{Binding LatencyEndpoints}"
                                                      SelectedItem="{Binding SelectedLatencyEndpoint, Mode=TwoWay}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Display}" />
                                                            <TextBlock Text="{Binding Why}" Style="{StaticResource HintStyle}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <TextBlock Text="Uygulanan değişiklikler"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,14,0,4" />
                                        <ItemsControl ItemsSource="{Binding LatencyAppliedChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Style="{StaticResource CaptionStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Tutulmayan değişiklikler"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,10,0,4" />
                                        <ItemsControl ItemsSource="{Binding LatencyRejectedChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource CaptionStyle}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,2">
                                                        <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding Change, Mode=OneWay}" />
                                                        <Run Text=" — " />
                                                        <Run Text="{Binding Reason, Mode=OneWay}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding LatencyPathSummary}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding LatencyPathSummary, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                        <TextBlock Text="{Binding LatencyStatusLine}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding LatencyStatusLine, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                        <TextBlock Text="Tam ölçüm raporu"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,14,0,4" />
                                        <Border Style="{StaticResource StatusPanelStyle}">
                                            <StackPanel>
                                                <ScrollViewer MaxHeight="220"
                                                              infra:NestedScrolling.BubbleWheel="True"
                                                              HorizontalScrollBarVisibility="Auto"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding LatencyResultSummary}"
                                                               Style="{StaticResource MonospaceStyle}"
                                                               TextWrapping="Wrap" />
                                                </ScrollViewer>
                                                <TextBlock Text="{Binding LatencyDataUsedSummary}"
                                                           Style="{StaticResource HintStyle}"
                                                           Margin="0,8,0,0"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Content="Hızlı ölçüm"
                                                    MinWidth="130"
                                                    Margin="0,0,8,8"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyTestCommand}" />
                                            <Button Content="Zorla yeniden ölç"
                                                    MinWidth="160"
                                                    Margin="0,0,8,8"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyRetestCommand}" />
                                            <Button Content="Kayıtlı sonuçları sil"
                                                    MinWidth="170"
                                                    Margin="0,0,0,8"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding LatencyClearProfilesCommand}" />
                                        </WrapPanel>

                                        <!-- Traffic Guard: the one intervention that moves
                                             loaded latency, and the one that costs upload
                                             speed. Both halves are stated. -->
                                        <TextBlock x:Name="TrafficGuardSection"
                                                   Text="Gönderim sınırı (Traffic Guard)"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0,16,0,6" />
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Ev bağlantılarında en büyük gecikme artışı boştaki ping değil, siz bir şey gönderirken oluşan kuyruklanmadır. Bu seçenek, seçtiğiniz uygulamanın giden trafiğini sınırlamak için bir Windows QoS ilkesi oluşturur; birkaç aday sınır ölçülür ve en iyisi ayrı bir turda doğrulanır. Kuyruklanma ölçülerek azalmazsa ilke silinir. Yalnız bu uygulamanın oluşturduğu ilkeler yönetilir; oyununuz sınırlanmaz. İndirme yönündeki kuyruk operatörün ekipmanında oluşur ve buradan uygulanan bir sınır ona ulaşamaz." />

                                        <CheckBox Content="Yük altında testte gönderim sınırını dene"
                                                  Margin="0,12,0,0"
                                                  Style="{StaticResource SwitchStyle}"
                                                  IsChecked="{Binding TrafficGuardEnabled, Mode=TwoWay}" />

                                        <TextBlock Text="Tercih"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,12,0,4" />
                                        <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                                  MinHeight="34"
                                                  MaxWidth="320"
                                                  HorizontalAlignment="Left"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding GuardModeOptions}"
                                                  SelectedItem="{Binding SelectedGuardMode, Mode=TwoWay}" />
                                        <TextBlock Text="{Binding SelectedGuardMode.Description}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Text="Sınırlanacak uygulama — oyun değil, toplu aktarım yapan program"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,12,0,4" />
                                        <ComboBox infra:NestedScrolling.IgnoreWheel="True"
                                                  MinHeight="34"
                                                  MaxWidth="420"
                                                  HorizontalAlignment="Left"
                                                  IsEditable="True"
                                                  VerticalContentAlignment="Center"
                                                  ItemsSource="{Binding LatencyProcesses}"
                                                  Text="{Binding TrafficGuardApplication, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="0,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Seçilen program çalışıyor olmalıdır; ilke, çalışan sürecin görüntü adı veya doğrulanmış tam yolu ile eşleştirilir." />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="Gönderim hızınız (Mbit/s)"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,0,0,4" />
                                                <TextBox MinHeight="34"
                                                         Width="120"
                                                         HorizontalAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding ManualUplinkMbps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="İndirme hızınız (Mbit/s)"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0,0,0,4" />
                                                <TextBox MinHeight="34"
                                                         Width="120"
                                                         HorizontalAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding ManualDownlinkMbps, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding LatencyGuardSummary}"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Margin="0,12,0,0"
                                                   TextWrapping="Wrap" />

                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="0,14,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Yalnızca ağ kartının geri alınabilir ayarları ve bu uygulamanın kendi QoS ilkeleri değiştirilir; IP, DHCP, ağ geçidi, DNS, IPv6 ve TCP kayıt defteri ayarları ile paket yolu bu özellik tarafından değiştirilmez." />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- ===== Vodafone Sınırsız Modu =====
                             Same shape: what network you are on, what the mode is doing
                             here, one button, then the findings as cards. The raw report
                             lives under "Teknik ayrıntılar" and is never parsed. -->
                        <Border x:Name="VodafoneSection" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Vodafone Sınırsız Modu"
                                               Style="{StaticResource SectionTitleStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0" />
                                    <CheckBox Grid.Column="1"
                                              Content="Etkin"
                                              Style="{StaticResource SwitchStyle}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Vodafone Sınırsız Modu'nu etkinleştir"
                                              IsChecked="{Binding VodafoneModeEnabled, Mode=TwoWay}" />
                                </Grid>

                                <TextBlock Text="{Binding VodafoneStatusLine}"
                                           Style="{StaticResource LatencyHeadlineStyle}"
                                           Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{Binding HotspotStatusSeverity, Converter={StaticResource SeverityBrushConverter}}" />

                                <!-- Whether the rule is actually installed, and the packet
                                     counter that proves it. The switch being on is not the
                                     same claim, and the card must not let the two blur. -->
                                <TextBlock Text="{Binding VodafoneRewriteLine}"
                                           Style="{StaticResource BodyStyle}"
                                           Margin="0,6,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           Foreground="{Binding VodafoneRewriteSeverity, Converter={StaticResource SeverityBrushConverter}}" />

                                <TextBlock Text="{Binding HotspotCheckedAt}"
                                           Style="{StaticResource HintStyle}"
                                           Margin="0,4,0,0" />

                                <Button Content="Bağlantıyı kontrol et"
                                        MinWidth="200"
                                        MinHeight="38"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        infra:ActionButton.Symbol="Search"
                                        Command="{Binding HotspotDiagnoseCommand}" />

                                <ProgressBar Height="3"
                                             Margin="0,12,0,0"
                                             IsIndeterminate="{Binding IsHotspotBusy}"
                                             Visibility="{Binding IsHotspotBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                             Background="{DynamicResource AppSubtleBackgroundBrush}"
                                             Foreground="{DynamicResource AppAccentBrush}" />

                                <!-- The findings as cards. "Desteklenmiyor",
                                     "kullanılmıyor" and "ölçülemedi" each get their own
                                     wording and colour; only a real fault is red. -->
                                <ItemsControl ItemsSource="{Binding HotspotCards}"
                                              Margin="0,14,0,0"
                                              Visibility="{Binding HasHotspotResult, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource InfoTileStyle}"
                                                    MinWidth="180"
                                                    MaxWidth="320"
                                                    Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource InfoTileLabelStyle}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Value}"
                                                               Style="{StaticResource InfoTileValueStyle}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding State, Converter={StaticResource CheckStateBrushConverter}}" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               Style="{StaticResource HintStyle}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding HotspotSuggestion}"
                                           Style="{StaticResource BodyStyle}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"
                                           Visibility="{Binding HotspotSuggestion, Converter={StaticResource EmptyToCollapsedConverter}}" />

                                <!-- The two options users confuse, side by side with the
                                     difference spelled out. -->
                                <Border Style="{StaticResource InfoTileStyle}" Margin="0,16,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Bu ağda kullan"
                                                           Style="{StaticResource FieldLabelStyle}"
                                                           Margin="0" />
                                                <TextBlock Style="{StaticResource HintStyle}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="Şu anda bağlı olduğunuz ağı listeye ekler. Modu kapatıp açmanız gerekmez." />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Bu ağı kaydet"
                                                    MinWidth="140"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding RememberVodafoneNetworkCommand}" />
                                        </Grid>

                                        <CheckBox Content="Kayıtlı ağlarda otomatik kontrol"
                                                  Margin="0,14,0,0"
                                                  Style="{StaticResource SwitchStyle}"
                                                  IsChecked="{Binding HotspotDiagnostics, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="26,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Kayıtlı bir ağa geçtiğinizde kontrolü kendiliğinden çalıştırır. Kapalıyken yukarıdaki düğme yine kullanılabilir." />

                                        <CheckBox Content="Giden IPv6 trafiğini kapat"
                                                  Margin="0,14,0,0"
                                                  Style="{StaticResource SwitchStyle}"
                                                  AutomationProperties.Name="Paylaşılan bağdaştırıcıda giden IPv6 trafiğini kapat"
                                                  IsChecked="{Binding VodafoneDropIPv6, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource HintStyle}"
                                                   Margin="26,2,0,0"
                                                   TextWrapping="Wrap"
                                                   Text="Telefon paylaşımı sırasında bilgisayara ayrı bir IPv6 adresi verilir; TTL ne olursa olsun bu tek başına paylaşımı belli eder. Ad çözümleme ve komşu keşfi geçmeye devam eder, bağlantınız kopmaz. Kapalı bırakmak yalnızca IPv6 gerektiren bir işiniz varsa mantıklıdır." />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Kayıtlı ağlar"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,16,0,4" />

                                <TextBlock Style="{StaticResource HintStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding HasVodafoneNetworks, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                           Text="Henüz kayıtlı ağ yok. Telefonunuzun paylaşımına bağlıyken “Bu ağı kaydet” ile ekleyebilirsiniz." />

                                <StackPanel Visibility="{Binding HasVodafoneNetworks, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Border Style="{StaticResource MonoPanelStyle}" Padding="6">
                                        <ListBox Style="{StaticResource PlainListStyle}"
                                                 MaxHeight="140"
                                                 AutomationProperties.Name="Kayıtlı ağlar"
                                                 ItemsSource="{Binding VodafoneNetworks}"
                                                 SelectedItem="{Binding SelectedVodafoneNetwork, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Display}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Marker}"
                                                                   Margin="10,0,0,0"
                                                                   Style="{StaticResource HintStyle}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <TextBlock Style="{StaticResource HintStyle}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="Modu kapatmak kayıtlı ağları silmez; bir ağı listeden çıkarmak için seçip “Seçili ağı unut” deyin." />
                                    <Button Content="Seçili ağı unut"
                                            MinWidth="150"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource SecondaryActionButtonStyle}"
                                            Command="{Binding ForgetVodafoneNetworkCommand}" />
                                </StackPanel>

                                <Expander Style="{StaticResource AdvancedExpanderStyle}" Margin="0,16,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="Teknik ayrıntılar"
                                                   Style="{StaticResource SectionTitleStyle}"
                                                   Margin="0" />
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CaptionStyle}"
                                                   TextWrapping="Wrap"
                                                   Text="Mod açıkken yalnızca kaydettiğiniz ağın bağdaştırıcısında, giden paketlerin TTL değeri yeniden yazılır; kalıcı bir sistem ayarı değiştirilmez ve mod kapandığında kural kaldırılır. “Bağlantıyı kontrol et” ise sıradan tanılama paketleri gönderir, hiçbir şeyi değiştirmez. Tarife ve hotspot hakkı ölçümle belirlenemediği için “Bilinmiyor” olarak kalır." />

                                        <ItemsControl ItemsSource="{Binding HotspotDetails}" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="120" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Title}"
                                                                   Style="{StaticResource CaptionStyle}"
                                                                   TextWrapping="Wrap" />
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <TextBlock Text="{Binding Value}"
                                                                       Style="{StaticResource CaptionStyle}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{Binding State, Converter={StaticResource CheckStateBrushConverter}}" />
                                                            <TextBlock Text="{Binding Detail}"
                                                                       Style="{StaticResource HintStyle}"
                                                                       TextWrapping="Wrap"
                                                                       Visibility="{Binding Detail, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="Tam rapor"
                                                   Style="{StaticResource FieldLabelStyle}"
                                                   Margin="0,12,0,4"
                                                   Visibility="{Binding HotspotReport, Converter={StaticResource EmptyToCollapsedConverter}}" />
                                        <Border Style="{StaticResource MonoPanelStyle}"
                                                Visibility="{Binding HotspotReport, Converter={StaticResource EmptyToCollapsedConverter}}">
                                            <ScrollViewer MaxHeight="200"
                                                          infra:NestedScrolling.BubbleWheel="True"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding HotspotReport}"
                                                           Style="{StaticResource MonospaceStyle}"
                                                           TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>

                                        <!-- Only shown when an older build actually left
                                             something behind on this machine. -->
                                        <StackPanel Margin="0,14,0,0"
                                                    Visibility="{Binding IsLegacyCleanupAvailable, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Style="{StaticResource CaptionStyle}"
                                                       TextWrapping="Wrap"
                                                       Text="Bu bilgisayarda eski sürümden kalan hotspot ayarları bulundu. Kaldırmak güvenlidir ve kayıtlı ağlarınızı silmez." />
                                            <Button Content="Eski kalıntıları temizle"
                                                    MinWidth="190"
                                                    Margin="0,8,0,0"
                                                    HorizontalAlignment="Left"
                                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                                    Command="{Binding HotspotCleanupCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                    </DataTemplate>
                </infra:DeferredTabContent.Template>
            </TabItem>

            <!-- ============ Günlük ============ -->
            <TabItem Style="{StaticResource NavTabItemStyle}"
                     AutomationProperties.Name="Günlük">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <infra:FluentIcon Style="{StaticResource NavIconStyle}" Symbol="TextBulletList" />
                        <AccessText Text="_Günlük" Margin="{StaticResource Nav.LabelOffset}" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Günlük" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="{Binding LogSummary, Mode=OneWay}"
                                       Style="{StaticResource CaptionStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Kopyala"
                                    MinWidth="110"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding CopyLogCommand}" />
                            <Button Content="Görünümü temizle"
                                    MinWidth="140"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding ClearLogCommand}" />
                            <Button Content="Klasörü aç"
                                    MinWidth="130"
                                    Margin="0,0,8,0"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Command="{Binding OpenLogFolderCommand}" />
                            <!-- One action instead of collecting the same evidence by
                                 hand from four screens. Read-only: it measures nothing
                                 and changes no setting. -->
                            <Button Content="Tanı raporu kaydet"
                                    MinWidth="170"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    AutomationProperties.Name="Tanı raporu kaydet"
                                    AutomationProperties.HelpText="Durumu, ölçümleri ve günlük kesitini maskelenmiş bir arşive yazar. Hiçbir yere gönderilmez."
                                    ToolTip="Durum, ölçümler ve günlük kesiti tek bir ZIP dosyasına yazılır. Ağ adı, donanım ve IP adresleri takma adlarla değiştirilir; dosya bu bilgisayarda kalır."
                                    Command="{Binding SaveDiagnosticReportCommand}" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock Grid.Row="0"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,-4"
                               TextWrapping="Wrap"
                               Style="{StaticResource SeverityStatusLineStyle}"
                               Text="{Binding DiagnosticReportStatus, Mode=OneWay}"
                               Tag="{Binding DiagnosticReportSeverity, Mode=OneWay}" />

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Level and search narrow the same list the copy button copies,
                             so what is on screen and what reaches the clipboard agree. -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Düzey"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource CaptionStyle}" />
                            <ComboBox Grid.Column="1"
                                      infra:NestedScrolling.IgnoreWheel="True"
                                      x:Name="LogLevelFilter"
                                      MinWidth="160"
                                      Margin="0,0,16,0"
                                      AutomationProperties.Name="Günlük düzeyi süzgeci"
                                      ItemsSource="{Binding LogLevelOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}" />

                            <TextBlock Grid.Column="2"
                                       Text="Ara"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource CaptionStyle}" />
                            <TextBox Grid.Column="3"
                                     x:Name="LogSearchBox"
                                     MinWidth="180"
                                     AutomationProperties.Name="Günlükte ara"
                                     AutomationProperties.HelpText="Görünen satırları metne göre süzer"
                                     Text="{Binding LogSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="6">
                            <ListBox x:Name="LogList"
                                     Style="{StaticResource MonospaceListStyle}"
                                     ItemContainerStyle="{StaticResource DomainRowStyle}"
                                     ItemsSource="{Binding VisibleLogLines}"
                                     AutomationProperties.Name="Günlük satırları"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ======================= Footer ======================= -->
        <Border Grid.Row="2"
                Style="{StaticResource ChromeBorderStyle}"
                BorderThickness="0,1,0,0"
                Padding="20,8,20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{DynamicResource AppAccentBrush}" />
                    <TextBlock Style="{StaticResource CaptionStyle}" VerticalAlignment="Center">
                        <Run Text="{Binding VersionLine, Mode=OneWay}" />
                        <Run Text=" · Yerel ve doğrudan bağlantı" />
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="_Çıkış"
                        MinWidth="110"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Click="OnExitClicked" />
            </Grid>
        </Border>
    </Grid>

    <!-- ======================= Karşılama =======================
         Brand, one card, and the way forward. The copy is four short sentences in
         Turkish, and it promises only what the app does: it finds settings that work on
         this network. No VPN, no anonymity, no encryption of the user's traffic. -->
    <Grid x:Name="WelcomeOverlay"
          Style="{StaticResource WelcomeOverlayStyle}"
          AutomationProperties.Name="Karşılama">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The light behind the greeting. First in the row so everything else draws over
             it, and not hit-testable, so it never comes between a button and a click. -->
        <Border x:Name="WelcomeGlow"
                Grid.Row="0"
                Style="{DynamicResource WelcomeGlowCurrentStyle}" />

        <!-- The card column is centred and capped, so the greeting reads the same in a
             narrow window and a maximised one, and scrolls rather than clipping when the
             window is short or the text scale is large. -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,0">
            <StackPanel MaxWidth="560"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,40">

                <!-- Brand. The existing identity, at a size that stays sharp at 200%. -->
                <StackPanel x:Name="WelcomeBrand" Style="{DynamicResource WelcomeBrandCurrentStyle}">
                    <Border Width="52" Height="52"
                            Background="{DynamicResource AppAccentSoftBrush}"
                            CornerRadius="{StaticResource Radius.Tile}">
                        <Image Width="40" Height="40"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Source="Assets/dpibypass-256.png" />
                    </Border>
                    <TextBlock Text="{Binding ProductTitle}"
                               FontSize="{StaticResource Type.Subtitle}"
                               FontWeight="SemiBold"
                               Margin="14,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </StackPanel>

                <!-- The card itself. Bound to the index rather than to the text, so moving
                     between cards re-instantiates the template and its Loaded trigger runs
                     the cross-fade: one place, no per-card triggers, and nothing to keep in
                     step when a card is added. -->
                <ContentControl x:Name="WelcomeCard"
                                Content="{Binding WelcomeIndex}"
                                ContentTemplate="{DynamicResource WelcomeCardTemplate}"
                                HorizontalAlignment="Stretch" />

                <!-- Progress. Dots for the tour, nothing for the one-line greeting. -->
                <ItemsControl ItemsSource="{Binding WelcomeSteps}"
                              HorizontalAlignment="Center"
                              Margin="0,32,0,0"
                              Focusable="False"
                              AutomationProperties.Name="{Binding WelcomeProgress}"
                              Visibility="{Binding IsWelcomeTour, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource WelcomeDotStyle}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions. Skip on the left because it is the quiet way out; Back and the
             primary action on the right, where the eye finishes. -->
        <Border x:Name="WelcomeActions"
                Grid.Row="1"
                Style="{StaticResource WelcomeActionsStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="_Atla"
                        MinWidth="110"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        AutomationProperties.Name="Tanıtımı atla"
                        Command="{Binding WelcomeSkipCommand}"
                        Visibility="{Binding IsWelcomeTour, Converter={StaticResource BoolToVisibilityConverter}}" />

                <CheckBox Grid.Column="1"
                          Content="Açılışta göster"
                          Margin="20,0"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Style="{StaticResource SwitchStyle}"
                          AutomationProperties.Name="Karşılamayı açılışta göster"
                          IsChecked="{Binding ShowWelcomeOnStartup, Mode=TwoWay}" />

                <Button Grid.Column="2"
                        Content="_Geri"
                        MinWidth="110"
                        Margin="0,0,8,0"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        infra:ActionButton.Symbol="ArrowLeft"
                        Command="{Binding WelcomeBackCommand}"
                        Visibility="{Binding IsWelcomeTour, Converter={StaticResource BoolToVisibilityConverter}}" />

                <Button Grid.Column="3"
                        Content="{Binding WelcomePrimaryAction}"
                        MinWidth="140"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        infra:ActionButton.Symbol="ArrowRight"
                        Command="{Binding WelcomeNextCommand}" />
            </Grid>
        </Border>
    </Grid>

    </Grid>
</Window>

{
  "manifest_version": 3,
  "name": "DPI Bypass Social Observer — Alpha",
  "version": "1.0.0",
  "description": "Locally observes one explicitly selected YouTube target. No account data or page text is exported.",
  "key": "",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage", "webRequest", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "background": { "service_worker": "worker.js" },
  "action": { "default_popup": "popup.html" }
}
